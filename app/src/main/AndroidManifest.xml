<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Voice capture, owned by PaneldService. The panel has one microphone and Android grants one
         capture client, so the boot-started agent owns capture and leases it out; nothing records
         until a feature takes a lease. The microphone foreground-service type is declared on that
         service alone, so no other component can reach the microphone — the camera trial below
         records no audio. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- TTS playback volume (STREAM_MUSIC via AudioManager). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- JmDNS multicast advertise requires holding a WifiManager.MulticastLock. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Auto-start the listener after a panel reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 11+ package visibility: ha-paneld must see/resolve the dashboard app (Companion) and
         other launchers to reload them and offer launcher/home navigation. Sideloaded panel agent,
         not a Play app, so the broad query permission is appropriate. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- Application-id migration. Both installable identities share one signer and declare this
         signature-level permission, so Android itself refuses the release-token broadcast from any
         package that is not the other identity of this app. -->
    <permission
        android:name="io.github.maxlyth.hapaneld.permission.IDENTITY_MIGRATION"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.maxlyth.hapaneld.permission.IDENTITY_MIGRATION" />
    <!-- Screen brightness via Settings.System (granted at provisioning: appops set WRITE_SETTINGS). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <!-- Soft navigation-bar overlay (TYPE_APPLICATION_OVERLAY) for panels whose firmware hides the
         native navbar. Not granted by default on the panels; NavbarController grants it via root appops. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Camera trial (experimental, off by default, offered only where the profile declares hardware.camera).
         The session runs under a dedicated camera-typed foreground service so Android 11+ grants it
         while-in-use access. The trial ships video only and records no audio: its service carries the
         camera type and nothing else, and the microphone permissions above belong to PaneldService. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Not required: most supported panels have no camera, and the permission alone would otherwise
         imply one and make the app uninstallable on them. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Configuration contains MQTT and Home Assistant credentials. Backups are exported only
         through ha-paneld's explicit sealed backup flow, never Android's implicit transport. -->
    <application
        android:name=".HaPaneldApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppCompat.DayNight">

        <!-- Signed candidate database boundary. Installers must read this from the exact APK they
             are about to apply; app version names and release tags are not compatibility evidence. -->
        <meta-data
            android:name="io.github.maxlyth.hapaneld.DATABASE_COMPATIBILITY"
            android:value="${databaseCompatibility}" />

        <!-- Official Shizuku Binder hand-off. The signature-level permission prevents ordinary apps
             from calling this exported provider; ha-paneld never opens an ADB or network listener. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConfigActivity"
            android:exported="false"
            android:label="@string/config_activity_label" />

        <activity
            android:name=".ProximityWizardActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/proximity_wizard_title" />

        <activity
            android:name=".GuardDbMaintenanceActivity"
            android:exported="false"
            android:label="@string/guard_db_activity_label" />

        <!-- Built-in dashboard renderer (experimental). exported so the privileged am start path can
             open it; singleTask so a repeat launch reaches the running instance (onNewIntent = reload)
             instead of stacking a second WebView. Declares CATEGORY_HOME (like AdminLauncherActivity) so
             ensureDashboardHome can set it as the default home when dashboard_package=builtin — boots to
             the dashboard + Home returns to it. NOT CATEGORY_LAUNCHER (a second MAIN/LAUNCHER activity
             makes the app's front door resolve to the chooser); MainActivity stays the sole launcher icon. -->
        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:label="@string/dashboard_activity_label"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <!-- configChanges: handle rotation + day/night (uiMode) in-place instead of letting Android
                 destroy/recreate the activity — a recreation reloads the whole dashboard, so without this
                 an always-on panel that auto-darkens reloads every dusk and dawn. We do our own force-dark,
                 so the system recreation buys nothing. (Same set the HA Companion uses.) -->
            <!-- Selectable / assignable HOME so it can become the boot-to dashboard home. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Admin app drawer. Reachable through the navbar/admin controls, as a selectable HOME app,
             and the HA/:8888 trigger. Explicitly choosing "Panel admin (ha-paneld)" as Launcher app
             makes this activity the enforced default HOME; otherwise it remains a last-resort HOME. It does
             NOT carry CATEGORY_LAUNCHER on purpose — a second MAIN/LAUNCHER activity makes the package's
             front-door launch ambiguous (Android resolves it to the system chooser instead of
             MainActivity, hiding the QR standing screen). MainActivity stays the sole launcher icon.
             not become the default merely by being installed. exported so the privileged am start path
             can open it. -->
        <activity
            android:name=".AdminLauncherActivity"
            android:exported="true"
            android:label="@string/admin_launcher_activity_label"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.AppCompat.DayNight">
            <!-- Selectable / last-resort HOME. Companion remains the default home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".PaneldService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <!-- Android 14+ requires declaring the specialUse subtype. ha-paneld is a
                 wall-panel hardware agent: a persistent on-LAN command/MQTT listener that
                 has no analogue in the predefined foreground-service types.
                 microphone is declared so the service can ADD that type for as long as something
                 holds a microphone lease; a type can only be claimed if it is declared here. The
                 service still starts as specialUse alone and claims microphone only while capture
                 is running, so an idle panel is not a microphone foreground service. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="ha-paneld persistent HTTP/MQTT listener for Home Assistant panel hardware control" />
        </service>

        <service
            android:name=".camera.CameraForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <service
            android:name=".GuardDbMaintenanceService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="writer-free same-boot SQLite recovery control plane" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The shell user holds DUMP; ordinary apps cannot arm or release the upgrade barrier. -->
        <receiver
            android:name=".UpgradeControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.maxlyth.hapaneld.action.PREPARE_UPGRADE" />
                <action android:name="io.github.maxlyth.hapaneld.action.RELEASE_UPGRADE" />
                <action android:name="io.github.maxlyth.hapaneld.action.RENEW_UPGRADE" />
            </intent-filter>
        </receiver>

        <!-- Receives the one-time release token from the other identity of this app during the
             application-id migration. Only a sender holding the signature permission is delivered. -->
        <receiver
            android:name=".migration.MigrationTokenReceiver"
            android:exported="true"
            android:permission="io.github.maxlyth.hapaneld.permission.IDENTITY_MIGRATION">
            <intent-filter>
                <action android:name="io.github.maxlyth.hapaneld.action.MIGRATION_TOKEN" />
                <action android:name="io.github.maxlyth.hapaneld.action.MIGRATION_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Optional hardware-button capture. Enabled at provisioning:
             settings put secure enabled_accessibility_services <pkg>/.input.PanelAccessibilityService -->
        <service
            android:name=".input.PanelAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

    </application>

</manifest>
