            candidate_apk_path="$(cat "$STATE_DIR/candidate-apk-path")"
            printf 'swapped after final compatibility gate and helper lease renewal\n' >> \
              "$candidate_apk_path"
          fi
          [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != lease ] && printf 'LEASE_OK\n'
        elif printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*(discover|status)-(system|systemless|hybrid)'; then
          printf 'JOURNAL_VERSION=1\nJOURNAL_SCOPE=%s\nTRANSACTION_ID=%s\nTARGET_APK_SHA256=%s\nTARGET_BUILD_ID=%s\nTARGET_HELPER_SHA256=%s\nLEASE_BOOT_ID=fixture-boot\nLEASE_UNTIL_UPTIME=999999\nLIVE_STATE=%s\n' \
            "${MOCK_STALE_SCOPE:-APK_HELPER}" "${MOCK_STALE_TRANSACTION_ID:-0123456789abcdef0123456789abcdef}" \
            "${MOCK_STALE_APK_SHA256:?}" \
            "${MOCK_STALE_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" "${MOCK_STALE_HELPER_SHA256:-$(printf '%064d' 0)}" \
            "${MOCK_STALE_LIVE_STATE:-TARGET}"
        elif printf '%s' "$command_text" 2>/dev/null | grep -Fq 'pidof hapaneld-helper'; then
          [ "${MOCK_HELPER_START:-ok}" = ok ] && printf '4242\n'
        elif helper_request_reply "$command_text"; then
          :
        fi
        ;;
      'su root "'*'"')
        if printf '%s' "$command_text" 2>/dev/null | grep -Fq 'id; id' && [ "${MOCK_SU_DIALECT:-join}" = rootjoin ]; then
          [ "${MOCK_ROOT:-1}" = 1 ] && printf 'uid=0(root) gid=0(root)\n'
        fi
        ;;
      'su root sh -c "'*'"')
        if printf '%s' "$command_text" 2>/dev/null | grep -Fq 'id; id' && [ "${MOCK_SU_DIALECT:-join}" = rootshc ]; then
          [ "${MOCK_ROOT:-1}" = 1 ] && printf 'uid=0(root) gid=0(root)\n'
        fi
        ;;
      'su -c "'*'"')
        if printf '%s' "$command_text" 2>/dev/null | grep -Fq 'id; id' && [ "${MOCK_SU_DIALECT:-join}" = suc ]; then
          [ "${MOCK_ROOT:-1}" = 1 ] && printf 'uid=0(root) gid=0(root)\n'
        fi
        ;;
      'su 0 sh -c "'*'"')
        if printf '%s' "$command_text" 2>/dev/null | grep -Fq 'id; id' && [ "${MOCK_SU_DIALECT:-join}" = shc ]; then
          [ "${MOCK_ROOT:-1}" = 1 ] && printf 'uid=0(root) gid=0(root)\n'
        elif stateful_helper_reply "$command_text"; then
          :
        elif standalone_manual_reply "$command_text"; then
          :
        elif printf '%s' "$command_text" 2>/dev/null | grep -Fq 'touch /system/.rw_probe'; then
          emit_system_layout_probe
        elif printf '%s' "$command_text" 2>/dev/null | grep -Fq '.hapaneld-rw-probe-'; then
          [ "${MOCK_VENDOR_INIT_RW:-1}" = 1 ] && printf 'VENDOR_INIT_RW\n'
        elif printf '%s' "$command_text" 2>/dev/null | grep -Fq 'echo TRANSACTION_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'TRANSACTION_READY\n'
        elif printf '%s' "$command_text" 2>/dev/null | grep -Fq 'echo PROBE_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'PROBE_READY\n'
        elif printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*install-(system|systemless|hybrid)'; then
          if [ "${MOCK_APP_REPLACEMENT_HOLD:-0}" = 1 ]; then
            printf 'APP_REPLACEMENT_HOLD\n'
          elif [ "${MOCK_TRANSACTION_BUSY:-0}" = 1 ]; then
            printf 'TRANSACTION_BUSY\n'
          elif [ -f "$STATE_DIR/stale-helper-transaction" ]; then
            case "${MOCK_ACTIVE_TRANSACTION_KIND:-${MOCK_STALE_TRANSACTION_KIND:-system}}" in
              system) [ "${MOCK_ACTIVE_TRANSACTION:-0}" = 1 ] && printf 'ACTIVE_SYSTEM_TRANSACTION\n' || printf 'STALE_SYSTEM_TRANSACTION\n' ;;
              systemless) [ "${MOCK_ACTIVE_TRANSACTION:-0}" = 1 ] && printf 'ACTIVE_SYSTEMLESS_TRANSACTION\n' || printf 'STALE_SYSTEMLESS_TRANSACTION\n' ;;
              hybrid) [ "${MOCK_ACTIVE_TRANSACTION:-0}" = 1 ] && printf 'ACTIVE_HYBRID_TRANSACTION\n' || printf 'STALE_HYBRID_TRANSACTION\n' ;;
              both) printf 'MULTIPLE_STALE_TRANSACTIONS\n' ;;
            esac
          elif [ "${MOCK_HELPER_INSTALL:-ok}" = retirement ]; then
            printf 'RETIREMENT_TIMEOUT helper_pids=4242 ledd_pids=none init_helper=running init_ledd=unset\n'
            # Name the kind the host actually asked for. A fixed `install_system` let the hybrid and
            # systemless arms answer with a marker for a function they never ran, which is the mask that
            # hid those two arms still rolling back a panel nothing had touched.
            printf 'INSTALL_UNCHANGED install_%s helper_retirement\n' \
              "$(printf '%s' "$command_text" | grep -oE 'install-(system|systemless|hybrid)' | head -1 | cut -d- -f2)"
          elif [ "${MOCK_HELPER_INSTALL:-ok}" = step_failed ]; then
            printf 'INSTALL_STEP_FAILED install_system cp_hapaneld-helper_new\n'
          elif [ "${MOCK_HELPER_INSTALL:-ok}" = step_failed_diag ]; then
            # The Issue #120 shape as a panel now answers it: the errno cp already printed, the two
            # bounded fixed-key lines beside it, then the same step marker as before. The helper is
            # staged under /data/local in this layout, so that is the directory a refused copy names.
            printf 'INSTALL_DIAG install_system cp_hapaneld-helper_new errno=cp: /data/local/.hapaneld-helper.provision-%s: No space left on device\n' "$MOCK_DIAG_ID"
            printf 'INSTALL_DIAG install_system cp_hapaneld-helper_new source=/data/local/tmp/hapaneld-helper-%s state=verified bytes=77848\n' "$MOCK_DIAG_ID"
            printf 'INSTALL_DIAG install_system cp_hapaneld-helper_new dir=/data/local mount=/data state=rw availkb=44 inodesfree=unknown mode=771 owner=2000:2000 selinux=Enforcing context=u:object_r:shell_data_file:s0\n'
            printf 'INSTALL_STEP_FAILED install_system cp_hapaneld-helper_new\n'
          elif [ "${MOCK_HELPER_INSTALL:-ok}" = preflight_space ]; then
            printf 'INSTALL_DIAG install_%s target dir=/data/local mount=/data state=rw availkb=44 inodesfree=unknown mode=771 owner=2000:2000 selinux=Enforcing context=u:object_r:shell_data_file:s0\n' \
              "$(printf '%s' "$command_text" | grep -oE 'install-(system|systemless|hybrid)' | head -1 | cut -d- -f2)"
            printf 'INSTALL_UNCHANGED install_%s target_insufficient_space\n' \
              "$(printf '%s' "$command_text" | grep -oE 'install-(system|systemless|hybrid)' | head -1 | cut -d- -f2)"
          elif [ "${MOCK_HELPER_INSTALL:-ok}" = preflight_readonly ]; then
            # The read-only case is the boot-file directory: the one place this layout still writes
            # on /system, and the mount a zero-byte probe at /system could never see.
            printf 'INSTALL_DIAG install_%s target dir=/system/etc/init mount=/system/etc/init state=ro availkb=98668 inodesfree=unknown mode=755 owner=0:0 selinux=Enforcing context=u:object_r:system_file:s0\n' \
              "$(printf '%s' "$command_text" | grep -oE 'install-(system|systemless|hybrid)' | head -1 | cut -d- -f2)"
            printf 'INSTALL_UNCHANGED install_%s target_read_only\n' \
              "$(printf '%s' "$command_text" | grep -oE 'install-(system|systemless|hybrid)' | head -1 | cut -d- -f2)"
          else
            [ "${MOCK_HELPER_INSTALL:-ok}" = ok ] && printf 'INSTALL_OK\n'
            [ "${MOCK_HELPER_INSTALL:-ok}" != ok ] || : > "$STATE_DIR/active-helper-transaction"
          fi
        elif printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*finalize-rollback-(system|systemless|hybrid)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != finalize ] && \
             [ "${MOCK_FINALIZE_RECORDED_STATE:-ok}" = ok ]; then
            printf 'ROLLBACK_FINALIZED\n'
            rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
          fi
        elif printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*rollback-(system|systemless|hybrid)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != rollback ]; then
            [ "${MOCK_ROLLBACK_RESULT:-ok}" = ok ] && [ "${MOCK_ROLLBACK_RETIREMENT:-ok}" = ok ] && printf 'ROLLBACK_RESTARTED\n'
          fi
        elif printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*commit-(system|systemless|hybrid)'; then
          if [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != commit ]; then
            if [ "${MOCK_HELPER_COMMIT:-ok}" = ok ] && [ "${MOCK_COMMIT_LIVE_STATE:-TARGET}" = TARGET ]; then
              printf 'COMMIT_OK\n'
              rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
            fi
          fi
        elif printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*lease-(system|systemless|hybrid)'; then
          printf x >> "$STATE_DIR/helper-lease-observation-count"
          helper_lease_observation_count="$(wc -c < "$STATE_DIR/helper-lease-observation-count")"
          candidate_contract_read_count="$(wc -c < "$STATE_DIR/candidate-contract-read-count" 2>/dev/null || printf 0)"
          if [ "${MOCK_SWAP_APK_AFTER_FINAL_GATE_LEASE:-0}" = 1 ] && \
             [ "$candidate_contract_read_count" -eq 3 ]; then
            candidate_apk_path="$(cat "$STATE_DIR/candidate-apk-path")"
            printf 'swapped after final compatibility gate and helper lease renewal\n' >> \
              "$candidate_apk_path"
          fi
          [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != lease ] && printf 'LEASE_OK\n'
        elif printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*(discover|status)-(system|systemless|hybrid)'; then
          printf 'JOURNAL_VERSION=1\nJOURNAL_SCOPE=%s\nTRANSACTION_ID=%s\nTARGET_APK_SHA256=%s\nTARGET_BUILD_ID=%s\nTARGET_HELPER_SHA256=%s\nLEASE_BOOT_ID=fixture-boot\nLEASE_UNTIL_UPTIME=999999\nLIVE_STATE=%s\n' \
            "${MOCK_STALE_SCOPE:-APK_HELPER}" "${MOCK_STALE_TRANSACTION_ID:-0123456789abcdef0123456789abcdef}" \
            "${MOCK_STALE_APK_SHA256:?}" \
            "${MOCK_STALE_BUILD_ID:-${MOCK_HELPER_BUILD_ID:?}}" "${MOCK_STALE_HELPER_SHA256:-$(printf '%064d' 0)}" \
            "${MOCK_STALE_LIVE_STATE:-TARGET}"
        fi
        ;;
      *)
        if printf '%s' "$command_text" 2>/dev/null | grep -Fq 'echo HAPANELD_TRANSPORT_ALIVE'; then
          # The snapshot's transport-liveness recheck. A live panel echoes the marker back exactly
          # as a real `adb shell echo` would; MOCK_SNAPSHOT_TRANSPORT=dead models the transport
          # dying mid-probe, which must read as "unknown", never as "no root";
          # dead_after_escalation keeps it alive until the `root` verb has restarted adbd.
          case "${MOCK_SNAPSHOT_TRANSPORT:-alive}" in
            alive) printf 'HAPANELD_TRANSPORT_ALIVE\n' ;;
            dead_after_escalation)
              [ -f "$STATE_DIR/adb-root-escalated" ] || printf 'HAPANELD_TRANSPORT_ALIVE\n' ;;
          esac
        elif adb_root_active && standalone_manual_reply "$command_text"; then
          :
        elif adb_root_active && stateful_helper_reply "$command_text"; then
          :
        elif adb_root_active && helper_request_reply "$command_text"; then
          :
        elif adb_root_active && printf '%s' "$command_text" 2>/dev/null | grep -Fq 'touch /system/.rw_probe'; then
          emit_system_layout_probe
        elif adb_root_active && printf '%s' "$command_text" 2>/dev/null | grep -Fq '.hapaneld-rw-probe-'; then
          [ "${MOCK_VENDOR_INIT_RW:-1}" = 1 ] && printf 'VENDOR_INIT_RW\n'
        elif adb_root_active && printf '%s' "$command_text" 2>/dev/null | grep -Fq 'echo TRANSACTION_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'TRANSACTION_READY\n'
        elif adb_root_active && printf '%s' "$command_text" 2>/dev/null | grep -Fq 'echo PROBE_READY'; then
          [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] && printf 'PROBE_READY\n'
        elif adb_root_active && printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*install-(system|systemless|hybrid)'; then
          if [ "${MOCK_APP_REPLACEMENT_HOLD:-0}" = 1 ]; then
            printf 'APP_REPLACEMENT_HOLD\n'
          elif [ "${MOCK_TRANSACTION_BUSY:-0}" = 1 ]; then
            printf 'TRANSACTION_BUSY\n'
          else
            printf 'INSTALL_OK\n'
          fi
        elif adb_root_active && printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*commit-(system|systemless|hybrid)'; then
          [ "${MOCK_HELPER_COMMIT:-ok}" = ok ] &&
            [ "${MOCK_COMMIT_LIVE_STATE:-TARGET}" = TARGET ] && printf 'COMMIT_OK\n'
        elif adb_root_active && printf '%s' "$command_text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*lease-(system|systemless|hybrid)'; then
          [ "${MOCK_TRANSACTION_TOKEN_MISMATCH:-0}" != 1 ] && [ "${MOCK_TOKEN_MISMATCH_ACTION:-}" != lease ] && printf 'LEASE_OK\n'
        fi
        ;;
    esac
    ;;
  *)
    ;;
esac
