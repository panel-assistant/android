#!/usr/bin/env bash
set -u

# Transport axis, independent of everything the device says. An adbd that does not advertise the
# `shell_v2` feature serves `shell:` through a PTY unconditionally, so the kernel line discipline
# turns every device newline into CRLF before the host ever sees it. MOCK_SHELL_CRLF=1 models that
# transport: the panel's answers are unchanged, only their line endings differ. Re-running the fixture
# through a filter keeps this one concern in one place rather than threading it through ~40 replies.
if [ "${MOCK_SHELL_CRLF:-0}" = 1 ] && [ -z "${MOCK_SHELL_CRLF_ACTIVE:-}" ]; then
  # The verb sits after any `-s <target>`, exactly as the dispatch below consumes it. Reading $1
  # directly would silently never match, leaving this axis switched off while still reporting green.
  if [ "${1:-}" = "-s" ]; then crlf_verb="${3:-}"; else crlf_verb="${1:-}"; fi
  if [ "$crlf_verb" = shell ]; then
    MOCK_SHELL_CRLF_ACTIVE=1 "$0" "$@" | sed -e $'s/$/\r/'
    exit "${PIPESTATUS[0]}"
  fi
fi

printf 'adb %s\n' "$*" >> "${MOCK_CALL_LOG:?MOCK_CALL_LOG is required}"
STATE_DIR="${MOCK_STATE_DIR:-$(dirname "$MOCK_CALL_LOG")}"
MOCK_DIAG_ID="${MOCK_DIAG_ID:-abcdef0123456789abcdef0123456789}"
HELPER_STATE_FIXTURE="$(cd "$(dirname "$0")" && pwd)/helper-state"
# A clean panel has no package at all. Without this the fixture would silently re-create one and a
# genuine first installation could never be modelled.
if [ "${MOCK_NO_INSTALLED_PACKAGE:-0}" != 1 ]; then
  [ -f "$STATE_DIR/installed-apk" ] || printf 'previous installed apk\n' > "$STATE_DIR/installed-apk"
fi

# adb-root is a TRANSITION, not a constant: MOCK_ADB_ROOT=1 models a panel already running adbd as
# root; the escalates* modes model a userdebug panel that answers uid=2000 until the `root` verb is
# called and only then changes state — the sequence the capture gate's escalation contracts need.
# escalates: `id` answers uid=0 after the verb. escalates_then_hang: the probe never answers after
# the verb. escalates_then_drop: the transport dies after the verb.
adb_root_active() {
  [ "${MOCK_ADB_ROOT:-0}" = 1 ] && return 0
  [ "${MOCK_ADB_ROOT:-0}" = escalates ] && [ -f "$STATE_DIR/adb-root-escalated" ]
}

# Standalone-installer traffic (helper/install-daemon.sh). The SAME block reaches this fixture
# su-wrapped on a `su` panel and BARE on an adbd-root panel, so both dispatch arms delegate here
# instead of keeping two copies. Before this existed only the su-wrapped arm answered it, so the
# direct-root path of the standalone installer had no coverage at all — which is how a
# direct-root-only defect reached a reporter (#106). Returns 1 when the command is not standalone
# traffic; when it is, it answers and exits with the status the panel would have returned.
standalone_manual_reply() {
  local text="$1"
  # Standalone v3 owns one canonical journal under /data/local; the other spellings are retained for
  # v1/v2 recovery. Neither pattern can match an APK-coupled provisioner journal
  # (`.helper-upgrade.marker`), which must keep falling through to its own branch.
  manual_journal_referenced() {
    printf '%s' "$1" 2>/dev/null | grep -Eq '\.hapaneld-helper-manual-upgrade|\.helper-manual-upgrade\.marker'
  }
  if printf '%s' "$text" 2>/dev/null | grep -Fq 'echo LEASE_OK' && manual_journal_referenced "$text"; then
    [ "${MOCK_MANUAL_LEASE_RENEW:-ok}" = ok ] && printf 'LEASE_OK\n'
    exit $?
  elif printf '%s' "$text" 2>/dev/null | grep -Fq 'inspect_manual_journal'; then
    if [ -f "$STATE_DIR/manual-helper-transaction" ]; then
      printf 'ACTIVE_SYSTEM_TRANSACTION\n'
    else
      printf 'NO_STALE_TRANSACTION\n'
    fi
    exit 0
  elif printf '%s' "$text" 2>/dev/null | grep -Fq 'echo INSTALL_OK' && manual_journal_referenced "$text"; then
    : > "$STATE_DIR/manual-helper-transaction"
    [ "${MOCK_MANUAL_INSTALL_DELAY:-0}" = 0 ] || /bin/sleep "$MOCK_MANUAL_INSTALL_DELAY"
    printf 'INSTALL_OK\n'
    exit 0
  elif printf '%s' "$text" 2>/dev/null | grep -Fq 'echo COMMIT_OK' && manual_journal_referenced "$text"; then
    rm -f "$STATE_DIR/manual-helper-transaction"
    printf 'COMMIT_OK\n'
    exit 0
  elif printf '%s' "$text" 2>/dev/null | grep -Fq 'ROLLBACK_RESTARTED' && manual_journal_referenced "$text"; then
    printf 'ROLLBACK_RESTARTED\n'
    exit 0
  elif printf '%s' "$text" 2>/dev/null | grep -Fq 'ROLLBACK_FINALIZED' && manual_journal_referenced "$text"; then
    rm -f "$STATE_DIR/manual-helper-transaction"
    printf 'ROLLBACK_FINALIZED\n'
    exit 0
  elif manual_journal_referenced "$text" &&
       printf '%s' "$text" 2>/dev/null | grep -Fq '[ ! -e' &&
       printf '%s' "$text" 2>/dev/null | grep -Fq '[ ! -L'; then
    [ "${MOCK_MANUAL_STALE:-0}" != 1 ]
    exit $?
  fi
  return 1
}

# The authenticated helper's request protocol, reached both su-wrapped and bare for the same reason.
helper_request_reply() {
  local text="$1"
  printf '%s' "$text" 2>/dev/null | grep -Fq ' --request ' || return 1
  if [ "${MOCK_HELPER_STATEFUL:-0}" = 1 ]; then
    local request_tail verb request_head helper_path
    request_tail="${text#* --request }"
    verb="${request_tail%%[!A-Z0-9_]*}"
    request_head="${text%% --request *}"
    helper_path="${request_head##* }"
    helper_path="${helper_path//\\/}"
    helper_path="${helper_path//\"/}"
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" request "$helper_path" "$verb"
    exit $?
  fi
  case "$text" in
    *' --request PING'*) [ "${MOCK_ROLLBACK_PING:-ok}" = ok ] && printf 'OK\n' ;;
    *' --request COMPANIONCAPS'*)
      [ "${MOCK_HELPER_REQUEST_DELAY:-0}" = 0 ] || /bin/sleep "$MOCK_HELPER_REQUEST_DELAY"
      [ "${MOCK_HELPER_START:-ok}" = ok ] && [ "${MOCK_HELPER_CAPABILITY:-ok}" = ok ] &&
        printf 'COMPANIONCAPS 1 BACKUP RESTORE STATUS JOURNAL\n'
      ;;
    *' --request BUILDID'*)
      [ "${MOCK_HELPER_REQUEST_DELAY:-0}" = 0 ] || /bin/sleep "$MOCK_HELPER_REQUEST_DELAY"
      [ "${MOCK_HELPER_BUILD_ID_MATCH:-ok}" = ok ] && printf 'BUILDID %s\n' "${MOCK_HELPER_BUILD_ID:?}"
      ;;
    *' --request GUARDCAPS'*)
      [ "${MOCK_HELPER_START:-ok}" = ok ] &&
        printf 'OK GUARDCAPS 1 PREPARE DEFINE STREAM ACTION HEALTH REFUSAL STATUS EVIDENCE CANCEL RETIRE JOURNAL AUTONOMOUS SUPERVISED TERMINAL_RETIRE\n'
      ;;
    *' --request GUARDSTATUS'*)
      [ "${MOCK_HELPER_START:-ok}" = ok ] &&
        printf 'OK GUARDSTATUS 0 EMPTY NONE NONE NONE NONE 0 0 0 NONE NONE 0 0\n'
      ;;
    *) printf 'ERR\n'; exit 1 ;;
  esac
  # A refused request answers nothing and exits non-zero, exactly as the inline branch did.
  exit $?
}

# Stateful managed-provision traffic.  The legacy fixture branches below remain available to the
# broad suite; this lane is enabled explicitly so focused tests observe one coherent device instead
# of choosing independent canned answers for install, requests, processes, and rollback.
stateful_helper_reply() {
  local text="$1" kind path launch_paths launch_count transaction_call action_kind transaction_id target_apk target_build target_helper transaction_open supervisors
  [ "${MOCK_HELPER_STATEFUL:-0}" = 1 ] || return 1

  if printf '%s' "$text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*discover-(system|systemless|hybrid)'; then
    kind="$(printf '%s' "$text" | sed -nE 's/.*discover-(systemless|hybrid|system).*/\1/p')"
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" record "$kind"
    exit $?
  elif printf '%s' "$text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*status-(system|systemless|hybrid)'; then
    transaction_call="$(printf '%s\n' "$text" | grep -oE 'status-(systemless|hybrid|system) [0-9a-f]{32} [0-9a-f]{64} [0-9a-f]{64} [0-9a-f]{64}' | tail -1)"
    set -- $transaction_call
    [ "$#" -eq 5 ] || exit 1
    action_kind="$1"; transaction_id="$2"; target_apk="$3"; target_build="$4"; target_helper="$5"
    kind="${action_kind#status-}"
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" record "$kind" "$transaction_id" "$target_apk" "$target_build" "$target_helper"
    exit $?
  elif printf '%s' "$text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*install-(system|systemless|hybrid)'; then
    # Keep systemless before system: ERE alternation is leftmost-first and `.*` would otherwise let
    # the shorter prefix classify install-systemless as install-system.
    transaction_call="$(printf '%s\n' "$text" | grep -oE 'install-(systemless|hybrid|system) [0-9a-f]{32} [0-9a-f]{64} [0-9a-f]{64} [0-9a-f]{64}' | tail -1)"
    set -- $transaction_call
    [ "$#" -eq 5 ] || exit 1
    action_kind="$1"; transaction_id="$2"; target_apk="$3"; target_build="$4"; target_helper="$5"
    kind="${action_kind#install-}"
    transaction_open="$(MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" inspect | sed -n 's/^TRANSACTION_OPEN=//p')"
    if [ "$transaction_open" = 1 ]; then
      printf 'STALE_%s_TRANSACTION\n' "$(printf '%s' "$kind" | tr '[:lower:]' '[:upper:]')"
      MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" event "STALE_DETECTED kind=$kind"
      exit 2
    fi
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" install "$kind" "$transaction_id" "$target_apk" "$target_build" "$target_helper"
    status=$?
    [ "$status" -ne 0 ] || : > "$STATE_DIR/active-helper-transaction"
    exit "$status"
  elif printf '%s' "$text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*finalize-rollback-(system|systemless|hybrid)'; then
    printf 'ROLLBACK_FINALIZED\n'
    rm -f "$STATE_DIR/stale-helper-transaction" "$STATE_DIR/active-helper-transaction"
    exit 0
  elif printf '%s' "$text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*rollback-(system|systemless|hybrid)'; then
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" rollback
    exit $?
  elif printf '%s' "$text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*commit-(system|systemless|hybrid)'; then
    if [ "${MOCK_STATEFUL_COMMIT_FAIL:-0}" = 1 ]; then
      MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" event COMMIT_REFUSED
      printf 'COMMIT_INVALID\n'
      exit 1
    fi
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" commit
    exit $?
  elif printf '%s' "$text" 2>/dev/null | grep -Eq 'helper-transaction-[0-9a-f]+.*lease-(system|systemless|hybrid)'; then
    printf 'LEASE_OK\n'
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" event LEASE_OK
    exit 0
  elif printf '%s' "$text" 2>/dev/null | grep -Fq ' --replacement-safe'; then
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" replacement-safe
    exit $?
  elif printf '%s' "$text" 2>/dev/null | grep -Fq 'echo HELPER_PROCESSES_PRESENT' && printf '%s' "$text" 2>/dev/null | grep -Fq 'echo NO_HELPER_PROCESSES'; then
    supervisors="$(MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" inspect | sed -n 's/^SUPERVISORS=//p')"
    if [ "$supervisors" = 0 ]; then
      printf 'NO_HELPER_PROCESSES\n'
      MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" event 'PROCESS_PROBE result=NO_HELPER_PROCESSES'
    else
      printf 'HELPER_PROCESSES_PRESENT\n'
      MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" event 'PROCESS_PROBE result=HELPER_PROCESSES_PRESENT'
    fi
    exit 0
  elif printf '%s' "$text" 2>/dev/null | grep -Fq 'pidof hapaneld-helper'; then
    supervisors="$(MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" inspect | sed -n 's/^SUPERVISORS=//p')"
    [ "$supervisors" = 1 ] && printf '4242\n'
    [ "$supervisors" = 1 ]
    exit $?
  elif printf '%s' "$text" 2>/dev/null | grep -Fq ' --request '; then
    helper_request_reply "$text"
  fi

  launch_paths="$(printf '%s\n' "$text" | grep -oE '/(data/local|system/bin|data/adb/hapaneld)/hapaneld-helper --supervise' | sed 's/ --supervise$//' || true)"
  launch_count="$(printf '%s\n' "$launch_paths" | awk 'NF { n++ } END { print n+0 }')"
  if [ "$launch_count" -gt 0 ]; then
    if printf '%s' "$text" 2>/dev/null | grep -Eq '(^|[ ;])stop hapaneld_helper|pkill -x hapaneld-helper'; then
      MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" stop >/dev/null
    fi
    # More than one syntactic launch authority in one command is malformed even if shell branching
    # would happen to choose one.  Tests can therefore kill fallback/rollback multi-authority mutants.
    [ "$launch_count" = 1 ] || { MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" event "LAUNCH_REFUSED syntactic-authorities=$launch_count"; exit 1; }
    path="$launch_paths"
    MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" launch "$path" supervised
    exit $?
  fi
  return 1
}

# Package presence and package-manager responsiveness are INDEPENDENT axes, because Android reports
# them through one exit status and the provisioner has to tell them apart (#89). MOCK_PM_PATH models
# the ha-paneld package; MOCK_PM_LIVENESS models the package manager itself, answering for framework
# packages that exist on every build. A clean panel is MOCK_PM_PATH=fail with MOCK_PM_LIVENESS=ok:
# the query "fails" precisely because the package is not installed.
#   ok      resolves to a path            fail  answers nothing, exit 1
#   absent  answers, names no path, exit 0  hang  never answers, so the caller's deadline expires
# Answer the nonce-marked package probe. Three INDEPENDENT axes, because conflating them is exactly
# how this defect survived two reviews:
#   MOCK_PM_PROBE      how the OBSERVATION as a whole fails
#     ok / truncated (END lost) / stale_nonce / out_of_order / hang / complete_then_fail
#   MOCK_PM_PATH       what the target child says      (ok / absent / fail / empty_path / relative_path)
#   MOCK_PM_TARGET_RC  what the target child's status is when it did NOT answer normally, e.g. 137 for
#                      a killed child or 2 for an internal error. This is the axis that was missing:
#                      the outer shell completes perfectly while only the child inside it dies.
#   MOCK_PM_LIVENESS / MOCK_PM_LIVE_RC   the same two axes for the framework query.
pm_marked_probe_reply() {
  local text="$1" nonce other trc lrc
  nonce="${text#*HAPANELD_PKG_BEGIN:}"
  nonce="${nonce%%[!0-9a-f]*}"
  other="${MOCK_PM_PROBE:-ok}"
  # MOCK_APK_QUERY models a package manager that stops answering AFTER a mutation is attempted. It
  # must reach this probe too, otherwise the fixture would claim a confident verdict from a package
  # manager it is simultaneously modelling as unanswerable.
  if [ "${MOCK_APK_QUERY:-ok}" != ok ] && [ -f "$STATE_DIR/apk-install-attempted" ]; then
    other=truncated
  fi
  # MOCK_PM_VANISH_AFTER models the package disappearing partway through a run: the first N marked
  # probes resolve it, later ones do not. It is what a reset target being uninstalled mid-run looks
  # like, which is the only way to reach the post-confirmation re-check's absent verdict.
  if [ -n "${MOCK_PM_VANISH_AFTER:-}" ]; then
    printf 'x' >> "$STATE_DIR/pm-probe-count"
    if [ "$(wc -c < "$STATE_DIR/pm-probe-count")" -gt "$MOCK_PM_VANISH_AFTER" ]; then
      MOCK_PM_PATH=absent
    fi
  fi
  if [ "$other" = hang ]; then
    [ -z "${MOCK_PM_PROBE_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_PM_PROBE_PID_FILE"
    trap 'exit 143' TERM INT
    while :; do /bin/sleep 1; done
  fi
  [ "$other" != stale_nonce ] || nonce="0123456789abcdef0123456789abcdef"
  # A real `pm path` exits 0 when it names a path and non-zero when the package is simply absent.
  case "${MOCK_PM_PATH:-ok}" in
    ok) trc=0 ;;
    *)  trc=1 ;;
  esac
  [ -z "${MOCK_PM_TARGET_RC:-}" ] || trc="$MOCK_PM_TARGET_RC"
  case "${MOCK_PM_LIVENESS:-ok}" in
    ok) lrc=0 ;;
    *)  lrc=1 ;;
  esac
  [ -z "${MOCK_PM_LIVE_RC:-}" ] || lrc="$MOCK_PM_LIVE_RC"
  if [ "$other" = out_of_order ]; then
    printf 'HAPANELD_PKG_TARGET:%s:%s\n' "$nonce" "$trc"
    printf 'HAPANELD_PKG_BEGIN:%s\n' "$nonce"
    printf 'HAPANELD_PKG_LIVE:%s:%s\n' "$nonce" "$lrc"
    printf 'HAPANELD_PKG_END:%s\n' "$nonce"
    exit 0
  fi
  printf 'HAPANELD_PKG_BEGIN:%s\n' "$nonce"
  pm_marked_paths "${MOCK_PM_PATH:-ok}" 'package:/data/app/io.github.maxlyth.hapaneld/base.apk' \
    "$([ -f "$STATE_DIR/installed-apk" ] && echo yes || echo no)"
  printf 'HAPANELD_PKG_TARGET:%s:%s\n' "$nonce" "$trc"
  pm_marked_paths "${MOCK_PM_LIVENESS:-ok}" 'package:/system/framework/framework-res.apk' yes
  printf 'HAPANELD_PKG_LIVE:%s:%s\n' "$nonce" "$lrc"
  # Complete, nonce-bound output from a command that nonetheless failed. The markers alone cannot
  # catch this, so it is what makes the caller's exit-status check load-bearing rather than redundant.
  [ "$other" != truncated ] || exit 0
  printf 'HAPANELD_PKG_END:%s\n' "$nonce"
  [ "$other" != complete_then_fail ] || exit 1
  exit 0
}

installer_marked_probe_reply() {
  local text="$1" nonce trc lrc urc installed=no retained_mode
  nonce="${text#*HAPANELD_INSTALLER_PKG_BEGIN:}"
  nonce="${nonce%%[!0-9a-f]*}"
  [ -f "$STATE_DIR/installed-apk" ] && installed=yes
  case "${MOCK_PM_PATH:-ok}" in ok) trc=0 ;; *) trc=1 ;; esac
  case "${MOCK_PM_LIVENESS:-ok}" in ok) lrc=0 ;; *) lrc=1 ;; esac
  retained_mode="${MOCK_PM_UNINSTALLED_RECORD:-absent}"
  printf 'HAPANELD_INSTALLER_PKG_BEGIN:%s\n' "$nonce"
  pm_marked_paths "${MOCK_PM_PATH:-ok}" 'package:/data/app/io.github.maxlyth.hapaneld/base.apk' "$installed"
  printf 'HAPANELD_INSTALLER_PKG_TARGET:%s:%s\n' "$nonce" "$trc"
  case "$retained_mode" in
    absent) urc=0 ;;
    retained) printf 'package:io.github.maxlyth.hapaneld\n'; urc=0 ;;
    malformed) printf 'package:other.package\n'; urc=0 ;;
    *) urc=1 ;;
  esac
  printf 'HAPANELD_INSTALLER_DATA:%s:%s\n' "$nonce" "$urc"
  pm_marked_paths "${MOCK_PM_LIVENESS:-ok}" 'package:/system/framework/framework-res.apk' yes
  printf 'HAPANELD_INSTALLER_PKG_LIVE:%s:%s\n' "$nonce" "$lrc"
  printf 'HAPANELD_INSTALLER_PKG_END:%s\n' "$nonce"
}

data_record_probe_reply() {
  local text="$1" nonce urc lrc mode
  nonce="${text#*HAPANELD_DATA_BEGIN:}"
  nonce="${nonce%%[!0-9a-f]*}"
  mode="${MOCK_PM_UNINSTALLED_RECORD:-absent}"
  case "${MOCK_PM_LIVENESS:-ok}" in ok) lrc=0 ;; *) lrc=1 ;; esac
  printf 'HAPANELD_DATA_BEGIN:%s\n' "$nonce"
  case "$mode" in
    absent) urc=0 ;;
    retained) printf 'package:io.github.maxlyth.hapaneld\n'; urc=0 ;;
    malformed) printf 'package:other.package\n'; urc=0 ;;
    *) urc=1 ;;
  esac
  printf 'HAPANELD_DATA_TARGET:%s:%s\n' "$nonce" "$urc"
  pm_marked_paths "${MOCK_PM_LIVENESS:-ok}" 'package:/system/framework/framework-res.apk' yes
  printf 'HAPANELD_DATA_LIVE:%s:%s\n' "$nonce" "$lrc"
  printf 'HAPANELD_DATA_END:%s\n' "$nonce"
}

# Emit the path lines one `pm path` would print inside the marked run. `empty_path` models a
# truncated line — a bare `package:` with nothing after it, which must never count as an answer.
pm_marked_paths() {
  local mode="$1" path="$2" installed="$3"
  case "$mode" in
    ok) [ "$installed" = yes ] && printf '%s\n' "$path" ;;
    empty_path) printf 'package:\n' ;;
    relative_path) printf 'package:data/app/base.apk\n' ;;
    absent|fail) ;;
    *) ;;
  esac
  return 0
}

pm_query_reply() {
  local mode="$1" path="$2" pid_file="${3:-}"
  case "$mode" in
    ok) printf '%s\n' "$path"; exit 0 ;;
    absent) exit 0 ;;
    fail) exit 1 ;;
    hang)
      [ -z "$pid_file" ] || printf '%s\n' "$$" > "$pid_file"
      trap 'exit 143' TERM INT
      while :; do /bin/sleep 1; done
      ;;
    *) printf 'mock adb: unknown pm query mode %s\n' "$mode" >&2; exit 64 ;;
  esac
}

emit_host_database_gate() {
  local primary primary_fingerprint recovery retained inventory inventory_fingerprint nonce observation_count
  nonce="${command_text#*HOSTDB_BEGIN:}"
  nonce="${nonce%%[!0-9a-f]*}"
  primary="${MOCK_HOST_DB_PRIMARY:-readable:${MOCK_DB_DEVICE_USER_VERSION:-9}:ok}"
  recovery="${MOCK_HOST_DB_RECOVERY:-none}"
  if [ -n "${MOCK_HOST_DB_RETAINED:-}" ]; then
    retained="$MOCK_HOST_DB_RETAINED"
  elif [ -f "$STATE_DIR/installed-apk" ]; then
    retained=1
  else
    retained=0
    primary=missing
  fi
  if [ -n "${MOCK_HOST_DB_INVENTORY:-}" ]; then
    inventory="$MOCK_HOST_DB_INVENTORY"
  elif [ -f "$STATE_DIR/installed-apk" ]; then
    inventory=readable
  else
    inventory=absent
  fi
  inventory_fingerprint="${MOCK_HOST_DB_INVENTORY_FINGERPRINT:-fixture:$recovery:$retained}"
  primary_fingerprint="${MOCK_HOST_DB_PRIMARY_FINGERPRINT:-fixture:$primary}"
  printf x >> "$STATE_DIR/host-db-observation-count"
  observation_count="$(wc -c < "$STATE_DIR/host-db-observation-count")"
  if [ "$observation_count" -gt 1 ]; then
    primary="${MOCK_HOST_DB_PRIMARY_AFTER_FIRST:-$primary}"
    primary_fingerprint="${MOCK_HOST_DB_PRIMARY_FINGERPRINT_AFTER_FIRST:-$primary_fingerprint}"
    recovery="${MOCK_HOST_DB_RECOVERY_AFTER_FIRST:-$recovery}"
    retained="${MOCK_HOST_DB_RETAINED_AFTER_FIRST:-$retained}"
    inventory="${MOCK_HOST_DB_INVENTORY_AFTER_FIRST:-$inventory}"
    inventory_fingerprint="${MOCK_HOST_DB_INVENTORY_FINGERPRINT_AFTER_FIRST:-$inventory_fingerprint}"
  fi
  if [ "$observation_count" -gt 2 ]; then
    primary="${MOCK_HOST_DB_PRIMARY_AFTER_SECOND:-$primary}"
    primary_fingerprint="${MOCK_HOST_DB_PRIMARY_FINGERPRINT_AFTER_SECOND:-$primary_fingerprint}"
    recovery="${MOCK_HOST_DB_RECOVERY_AFTER_SECOND:-$recovery}"
    retained="${MOCK_HOST_DB_RETAINED_AFTER_SECOND:-$retained}"
    inventory="${MOCK_HOST_DB_INVENTORY_AFTER_SECOND:-$inventory}"
    inventory_fingerprint="${MOCK_HOST_DB_INVENTORY_FINGERPRINT_AFTER_SECOND:-$inventory_fingerprint}"
  fi
  if [ -f "$STATE_DIR/package-data-cleared" ]; then
    primary=missing
    primary_fingerprint=none
    recovery=none
    retained=0
    inventory=readable
    inventory_fingerprint=none
  fi
  [ "${MOCK_HOST_DB_OBSERVATION:-ok}" = ok ] || { printf 'HOSTDB_BEGIN:%s\n' "$nonce"; return 0; }
  printf 'HOSTDB_BEGIN:%s\n' "$nonce"
  printf 'HOSTDB_PRIMARY=%s\n' "$primary"
  printf 'HOSTDB_PRIMARY_FINGERPRINT=%s\n' "$primary_fingerprint"
  printf 'HOSTDB_RECOVERY=%s\n' "$recovery"
  printf 'HOSTDB_RETAINED=%s\n' "$retained"
  printf 'HOSTDB_INVENTORY=%s\n' "$inventory"
  printf 'HOSTDB_INVENTORY_FINGERPRINT=%s\n' "$inventory_fingerprint"
  printf 'HOSTDB_END:%s\n' "$nonce"
  if [ -n "${MOCK_PACKAGE_APPEAR_AFTER_DB_OBSERVATION:-}" ] && \
     [ "$observation_count" -eq "$MOCK_PACKAGE_APPEAR_AFTER_DB_OBSERVATION" ]; then
    printf 'externally installed apk\n' > "$STATE_DIR/installed-apk"
  fi
}

emit_legacy_installer_database_inventory() {
  local nonce app_data database recovery inventory observation_count
  nonce="${command_text#*HAPANELD_INSTALLER_DB_BEGIN:}"
  nonce="${nonce%%[!0-9a-f]*}"
  app_data="${MOCK_INSTALLER_APP_DATA:-absent}"
  database="${MOCK_INSTALLER_DATABASE:-absent}"
  recovery="${MOCK_INSTALLER_RECOVERY:-absent}"
  inventory="${MOCK_INSTALLER_INVENTORY:-readable}"
  printf x >> "$STATE_DIR/installer-db-observation-count"
  observation_count="$(wc -c < "$STATE_DIR/installer-db-observation-count")"
  if [ "$observation_count" -gt 1 ]; then
    app_data="${MOCK_INSTALLER_APP_DATA_AFTER_FIRST:-$app_data}"
    database="${MOCK_INSTALLER_DATABASE_AFTER_FIRST:-$database}"
    recovery="${MOCK_INSTALLER_RECOVERY_AFTER_FIRST:-$recovery}"
    inventory="${MOCK_INSTALLER_INVENTORY_AFTER_FIRST:-$inventory}"
  fi
  printf 'HAPANELD_INSTALLER_DB_BEGIN:%s\n' "$nonce"
  printf 'HAPANELD_INSTALLER_ROOT_UID:zero\n'
  printf 'HAPANELD_INSTALLER_APP_DATA:%s\n' "$app_data"
  printf 'HAPANELD_INSTALLER_DATABASE:%s\n' "$database"
  printf 'HAPANELD_INSTALLER_RECOVERY:%s\n' "$recovery"
  printf 'HAPANELD_INSTALLER_INVENTORY:%s\n' "$inventory"
  printf 'HAPANELD_INSTALLER_DB_END:%s\n' "$nonce"
}

mark_hapaneld_stopped() {
  local apk_path="$1"
  if [ "${MOCK_STOPPED_STATE:-0}" = 1 ] && [[ "$apk_path" != */shizuku.apk ]]; then
    : > "$STATE_DIR/package-stopped"
  fi
}

emit_system_layout_probe() {
  if [ "${MOCK_SYSTEM_WRITABLE:-1}" = 1 ]; then
    printf 'SYSTEM_RW\n'
    if [ "${MOCK_DEVICE_AWK:-present}" = missing ] &&
       printf '%s\n' "$command_text" 2>/dev/null | grep -Eq 'df[^|]*/system[^|]*\|[[:space:]]*awk'; then
      printf 'SYSTEM_CAPACITY_UNKNOWN\n'
    elif ! printf '%s\n' "$command_text" 2>/dev/null | grep -Fq 'df -P -k /system'; then
      printf 'SYSTEM_CAPACITY_UNKNOWN\n'
    else
      case "${MOCK_SYSTEM_CAPACITY:-valid}" in
        valid) printf 'SYSTEM_AVAIL_KB=%s\n' "${MOCK_SYSTEM_AVAIL_KB:-1048576}" ;;
        malformed|ambiguous|missing|missing-df|missing-sed) printf 'SYSTEM_CAPACITY_UNKNOWN\n' ;;
      esac
    fi
  else
    printf 'SYSTEM_RO\n'
    if [ "${MOCK_SYSTEMLESS_RUNNER:-1}" = 1 ]; then printf 'SYSTEMLESS_RUNNER\n'; else printf 'NO_SYSTEMLESS_RUNNER\n'; fi
  fi
  case "${MOCK_VENDOR_RC_STATE:-missing}" in
    missing) ;;
    managed) printf 'VENDOR_RC_MANAGED\n' ;;
    unexpected) printf 'VENDOR_RC_UNEXPECTED\n' ;;
  esac
}

# The database capture is ONE pushed transaction script. The fixture does not emulate it — it saves
# the pushed bytes and EXECUTES them for real in a path-rewritten sandbox with stub sqlite3/dumpsys
# on PATH, so every contract observes the shipped script's own semantics. A model can agree with a
# test and disagree with production; an executed script cannot.
DB_TXN_SANDBOX="$STATE_DIR/db-txn-sandbox"
prepare_db_txn_sandbox() {
  [ -d "$DB_TXN_SANDBOX/bin" ] && return 0
  mkdir -p "$DB_TXN_SANDBOX/data/local/tmp" "$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases" "$DB_TXN_SANDBOX/bin"
  canonical_db="$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db"
  rm -f "$canonical_db"
  "${HAPANELD_HOST_SQLITE3:-sqlite3}" "$canonical_db" >/dev/null <<'SQL'
PRAGMA journal_mode=WAL;
PRAGMA user_version=9;
CREATE TABLE app_state (key TEXT PRIMARY KEY, value TEXT NOT NULL);
INSERT INTO app_state VALUES
 ('fixture-1','1'),('fixture-2','2'),('fixture-3','3'),('fixture-4','4'),
 ('fixture-5','5'),('fixture-6','6'),('fixture-7','7');
SQL
  "${HAPANELD_HOST_SQLITE3:-sqlite3}" "$canonical_db" 'PRAGMA wal_checkpoint(TRUNCATE);' >/dev/null
  # A cleanly present zero-byte WAL is a NORMAL source state and must never affect a .backup capture.
  : > "$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db-wal"
  cat > "$DB_TXN_SANDBOX/bin/sqlite3" <<'STUB'
#!/bin/bash
db="$1"; shift; op="$*"
case "$op" in
  *.backup*)
    [ -z "${MOCK_CALL_LOG:-}" ] || printf 'sqlite3 .backup\n' >> "$MOCK_CALL_LOG"
    [ "${MOCK_DB_TXN:-ok}" = backup_fail ] && exit 1
    dest="${op#*.backup \'}"; dest="${dest%\'*}"
    cp "$db" "$dest" || exit 1
    if [ "${MOCK_DB_TXN:-ok}" = backup_empty ]; then : > "$dest"; fi
    ;;
  *integrity_check*)
    if [ "${MOCK_DB_TXN:-ok}" = integrity_bad ]; then echo '*** in database main ***'; else echo ok; fi ;;
  *'count(*) FROM app_state'*) echo "${MOCK_DB_DEVICE_ROWS:-7}" ;;
  *user_version*) echo "${MOCK_DB_DEVICE_USER_VERSION:-9}" ;;
  *) exit 1 ;;
esac
exit 0
STUB
  cat > "$DB_TXN_SANDBOX/bin/dumpsys" <<'STUB'
#!/bin/bash
[ "${MOCK_DB_DEVICE_VCODE:-513}" = absent ] && exit 0
if [ "${MOCK_DB_TXN:-ok}" = provenance_race ]; then
  # Every dumpsys call answers a different build: the capture's before/after reads can never agree.
  count_file="${MOCK_STATE_DIR:?}/db-txn-vcode-count"
  count=$(( $(cat "$count_file" 2>/dev/null || echo 0) + 1 ))
  printf '%s' "$count" > "$count_file"
  printf '    versionCode=%s minSdk=26 targetSdk=35\n' $((500 + count))
else
  printf '    versionCode=%s minSdk=26 targetSdk=35\n' "${MOCK_DB_DEVICE_VCODE:-513}"
fi
printf '    versionName=0.9.6-test\n'
STUB
  cat > "$DB_TXN_SANDBOX/bin/sha256sum" <<'STUB'
#!/bin/bash
[ "${MOCK_DB_TXN:-ok}" = no_device_digest ] && exit 1
exec /usr/bin/sha256sum "$@"
STUB
  cat > "$DB_TXN_SANDBOX/bin/toybox" <<'STUB'
#!/bin/bash
[ "$1" = sha256sum ] || exit 1
[ "${MOCK_DB_TXN:-ok}" = no_device_digest ] && exit 1
shift
exec /usr/bin/sha256sum "$@"
STUB
  cat > "$DB_TXN_SANDBOX/bin/busybox" <<'STUB'
#!/bin/bash
[ "$1" = sha256sum ] || exit 1
[ "${MOCK_DB_TXN:-ok}" = no_device_digest ] && exit 1
shift
exec /usr/bin/sha256sum "$@"
STUB
  chmod 755 "$DB_TXN_SANDBOX/bin/sha256sum" "$DB_TXN_SANDBOX/bin/toybox" "$DB_TXN_SANDBOX/bin/busybox"
  chmod 755 "$DB_TXN_SANDBOX/bin/sqlite3" "$DB_TXN_SANDBOX/bin/dumpsys"
}

run_db_txn_script() {
  prepare_db_txn_sandbox
  [ -s "$STATE_DIR/db-txn-script.$ADB_TARGET" ] || { echo 'SNAPTXN_FAIL=script_missing'; return 1; }
  if [ "${MOCK_DB_TXN:-ok}" = stage_collision ]; then
    # Another owner already holds the exact staging path this transaction wants: pre-create it with
    # a marker file, so the survival of that marker proves the loser removed nothing.
    collision_stage="$(grep -oE '/data/local/tmp/\.hapaneld-db-txn\.[0-9a-f]+' "$STATE_DIR/db-txn-script.$ADB_TARGET" | head -1)"
    mkdir -p "$DB_TXN_SANDBOX${collision_stage}"
    : > "$DB_TXN_SANDBOX${collision_stage}/winner-in-flight"
  fi
  sed -e "s|/data/|$DB_TXN_SANDBOX/data/|g" -e "s|/system/bin/sqlite3|$DB_TXN_SANDBOX/bin/sqlite3|g" \
    "$STATE_DIR/db-txn-script.$ADB_TARGET" > "$STATE_DIR/db-txn-script.runnable.$ADB_TARGET"
  PATH="$DB_TXN_SANDBOX/bin:$PATH" bash "$STATE_DIR/db-txn-script.runnable.$ADB_TARGET"
}

handle_db_txn_command() {
  local text="$1"
  case "$text" in
    *sha256sum*.hapaneld-db-txn.*-script*)
      [ "${MOCK_DB_TXN:-ok}" != panel_hash_transport ] || return 1
      prepare_db_txn_sandbox
      if [ "${MOCK_DB_TXN:-ok}" = script_tamper ]; then
        printf '%064d  tampered\n' 1
      else
        /usr/bin/sha256sum "$STATE_DIR/db-txn-script.$ADB_TARGET" 2>/dev/null | awk '{print $1"  script"}'
      fi
      return 0 ;;
    *'sh /data/local/tmp/.hapaneld-db-txn.'*-script*)
      run_db_txn_script
      return 0 ;;
    *.hapaneld-db-txn.*HAPANELD_STALE_PRESENT*)
      case "${MOCK_DB_CLEANUP:-ok}" in
        unverifiable) return 1 ;;
        retained) printf 'HAPANELD_STALE_PRESENT\n' ;;
        *)
          # Answer from sandbox truth for the EXACT path the probe names — absence is asserted by
          # what the executed cleanup really left, and one run's leftovers never answer for another.
          probed="$(printf '%s' "$text" | grep -oE '/data/local/tmp/\.hapaneld-db-txn\.[0-9a-f]+' | head -1)"
          if [ -n "$probed" ] && [ -e "$DB_TXN_SANDBOX/data/local/tmp/${probed#/data/local/tmp/}" ]; then
            printf 'HAPANELD_STALE_PRESENT\n'
          else
            printf 'HAPANELD_STALE_ABSENT\n'
          fi ;;
      esac
      return 0 ;;
    *'rm -'*.hapaneld-db-txn.*)
      # block models the post-publication cleanup wedging on a failing transport, so a test can
      # deliver the operator's Ctrl-C exactly inside that window and observe what survives it. It
      # blocks only the FIRST cleanup: the signal path retries the same removal from its handler,
      # and blocking that retry too would wedge the handler the test is trying to observe.
      if [ "${MOCK_DB_CLEANUP:-ok}" = block ] && [ ! -f "$STATE_DIR/db-cleanup-blocked-once" ]; then
        : > "$STATE_DIR/db-cleanup-blocked-once"
        [ -z "${MOCK_DB_CLEANUP_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_DB_CLEANUP_PID_FILE"
        exec /bin/sleep "${MOCK_DB_CLEANUP_BLOCK_SECONDS:-30}"
      fi
      if [ "${MOCK_DB_CLEANUP:-ok}" = ok ]; then
        rm -rf "$DB_TXN_SANDBOX/data/local/tmp"/.hapaneld-db-txn.* 2>/dev/null
      fi
      return 0 ;;
  esac
  return 1
}

# Model the panel's id-named staging as real files. The journal was modelled as boolean flag files
# that the harness reset before every run, so no test could observe staging carried between runs —
# that blind spot is why Issue #76's accumulation was invisible to a green suite. Both halves of a
# run's staging are modelled: the protected transaction record in /data/adb/hapaneld AND the pushed
# bundle in /data/local/tmp, flattened by basename into one directory.
DEVICE_ADB_DIR="$STATE_DIR/device-data-adb-hapaneld"

device_adb_paths() {
  printf '%s' "$1" \
    | grep -oE '/data/(adb/hapaneld/\.helper-(transaction|probe)|local/tmp/hapaneld-helper)-[0-9a-f]+(-[0-9a-f]+)?(\.[a-z]+)?' \
    || true
}

model_device_adb_dir() {
  local text="$1" path
  case "$text" in
    *'echo TRANSACTION_READY'*|*'echo PROBE_READY'*)
      [ "${MOCK_TRANSACTION_TAMPER:-0}" != 1 ] || return 0
      mkdir -p "$DEVICE_ADB_DIR" || return 0
      for path in $(device_adb_paths "$text"); do
        : > "$DEVICE_ADB_DIR/${path##*/}"
      done
      # The promotion command names both <record>.new and <record>; its mv -f leaves only the
      # final record, so a phantom .new must not survive in the model.
      rm -f "$DEVICE_ADB_DIR"/.helper-transaction-*.new
      return 0
      ;;
  esac
  case "$text" in
    *'rm -f '*)
      for path in $(device_adb_paths "$text"); do
        rm -f "$DEVICE_ADB_DIR/${path##*/}"
      done
      # A glob in a privileged rm expands on the panel; expand it in the model too, or a too-broad
      # wildcard cleanup would sail past the identity-scoping survival contracts.
      for pattern in $(printf '%s' "$text" | grep -oE '/data/(adb/hapaneld/\.helper-[a-z]+|local/tmp/hapaneld-helper)-[0-9a-f-]*\*' || true); do
        base="${pattern##*/}"
        rm -f "$DEVICE_ADB_DIR/${base%\*}"* 2>/dev/null || true
      done
      ;;
  esac
}

if [ "${1:-}" = "connect" ]; then
  exit 0
fi

if [ "${1:-}" = "devices" ]; then
  # hang_after_escalation models adb wedging in the reconnect window the `root` verb opened, so a
  # test can prove the escalation's aggregate deadline instead of the per-step adb deadline.
  if [ "${MOCK_ADB_DEVICES:-ok}" = hang_after_escalation ] && [ -f "$STATE_DIR/adb-root-escalated" ]; then
    trap 'exit 143' TERM INT
    while :; do /bin/sleep 1; done
  fi
  state="${MOCK_ADB_STATE:-device}"
  printf 'List of devices attached\n'
  if [ "$state" != "missing" ]; then
    for target in ${MOCK_TARGETS:-${MOCK_TARGET:-panel.test:5555}}; do printf '%s\t%s\n' "$target" "$state"; done
  fi
  exit 0
fi

ADB_TARGET=""
if [ "${1:-}" = "-s" ]; then
  ADB_TARGET="${2:-}"
  shift 2
fi

# Runtime permissions belong to one Android target. Fleet workers deliberately share the fixture
# directory, so unqualified markers let one mock panel observe another panel's permission state.
grant_state_suffix=""
if [ -n "$ADB_TARGET" ]; then
  grant_state_suffix=".$(printf '%s' "$ADB_TARGET" | tr -c 'A-Za-z0-9._-' '_')"
fi
record_audio_grant_state="$STATE_DIR/record-audio-granted$grant_state_suffix"
post_notifications_grant_state="$STATE_DIR/post-notifications-granted$grant_state_suffix"
write_settings_grant_state="$STATE_DIR/write-settings-granted$grant_state_suffix"

# The panel's platform level, as a number the fixture can compare. A non-numeric MOCK_SDK is a test
# bug rather than a device state, so it falls back to the default instead of breaking arithmetic.
mock_sdk_level() {
  local level="${MOCK_SDK-33}"
  case "$level" in
    ''|*[!0-9]*) level=33 ;;
  esac
  printf '%s\n' "$level"
}

VERIFY_GRANTS_OK=1
if [ "${MOCK_VERIFY:-ok}" = fail ] || \
   { [ -n "${MOCK_VERIFY_FAIL_HOST:-}" ] && \
     { [ "$ADB_TARGET" = "$MOCK_VERIFY_FAIL_HOST" ] || [ "$ADB_TARGET" = "$MOCK_VERIFY_FAIL_HOST:5555" ]; }; }; then
  VERIFY_GRANTS_OK=0
fi

case "${1:-}" in
  root)
    case "${MOCK_ADB_ROOT:-0}" in
      escalates|escalates_then_hang|escalates_then_drop)
        : > "$STATE_DIR/adb-root-escalated" ;;
      *)
        [ "${MOCK_ROOT:-1}" = 1 ] ;;
    esac
    ;;
  push)
    # A pushed staged input becomes a real modelled file, so its later reclamation is observable.
    for pushed in "$@"; do
      case "$pushed" in
        /data/local/tmp/hapaneld-helper-*)
          mkdir -p "$DEVICE_ADB_DIR" && : > "$DEVICE_ADB_DIR/${pushed##*/}" ;;
      esac
    done
    # The capture transaction script's exact pushed bytes are saved so the fixture can hash and
    # EXECUTE what production actually sent, not a paraphrase of it.
    case "${3:-}" in
      /data/local/tmp/.hapaneld-db-observer.*-script)
        cp "${2:?push source missing}" "$STATE_DIR/db-observer-script.$ADB_TARGET"
        printf '%s\n' "${3:?push destination missing}" > "$STATE_DIR/db-observer-remote.$ADB_TARGET" ;;
      /data/local/tmp/.hapaneld-db-txn.*-script)
        [ "${MOCK_DB_TXN:-ok}" = push_fail ] && exit 1
        cp "${2:?push source missing}" "$STATE_DIR/db-txn-script.$ADB_TARGET" ;;
    esac
    if [ "${MOCK_HELPER_STATEFUL:-0}" = 1 ]; then
      MOCK_STATE_DIR="$STATE_DIR" "$HELPER_STATE_FIXTURE" capture "${2:?push source missing}" "${3:?push destination missing}"
    fi
    ;;
  pull)
    # MOCK_APK_QUERY=fail models a package manager that became unanswerable at the install-outcome
    # moment; queries before any install attempt still succeed, so pre-mutation stages (the database
    # capture included) observe the panel as it was.
    if [ "${MOCK_APK_QUERY:-ok}" != ok ] && [ -f "$STATE_DIR/apk-install-attempted" ]; then exit 1; fi
    case "${2:-}" in
      *.hapaneld-db-txn.*/ha-paneld.db)
        [ "${MOCK_DB_TXN:-ok}" = pull_fail ] && exit 1
        # The pulled bytes come from the sandbox the executed script actually wrote, so a transfer
        # contract observes the real captured file, not a manufactured stand-in.
        cp "$DB_TXN_SANDBOX/data/local/tmp/${2#/data/local/tmp/}" "${3:?pull destination missing}" 2>/dev/null || exit 1
        if [ "${MOCK_DB_TXN:-ok}" = pull_truncate ]; then printf 'short' > "$3"; fi
        ;;
      *) cp "$STATE_DIR/installed-apk" "${3:?pull destination missing}" ;;
    esac
    ;;
  exec-out)
    shift
    command_text="$*"
    case "$command_text" in
      *'cat /data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db'*)
        if [ "${MOCK_DIRECT_COPY:-ok}" = block ]; then
          [ -z "${MOCK_DIRECT_COPY_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_DIRECT_COPY_PID_FILE"
          exec /bin/sleep "${MOCK_DIRECT_COPY_BLOCK_SECONDS:-30}"
        fi
        [ "${MOCK_DIRECT_COPY:-ok}" = ok ] || exit 1
        prepare_db_txn_sandbox
        cat "$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db"
        ;;
      *) exit 1 ;;
    esac
    ;;
  install)
    : > "$STATE_DIR/apk-install-attempted"
    if [[ "${!#}" == */shizuku.apk ]] && [ "${MOCK_SHIZUKU_INSTALL:-ok}" = block ]; then
      [ -z "${MOCK_SHIZUKU_INSTALL_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_SHIZUKU_INSTALL_PID_FILE"
      trap 'exit 143' TERM INT
      while :; do /bin/sleep 1; done
    elif [ "${MOCK_APK_INSTALL:-ok}" = block ] || [ "${MOCK_APK_INSTALL:-ok}" = ignore_term ]; then
      [ -z "${MOCK_APK_INSTALL_PID_FILE:-}" ] || printf '%s\n' "$$" > "$MOCK_APK_INSTALL_PID_FILE"
      if [ "${MOCK_APK_INSTALL:-ok}" = ignore_term ]; then trap '' TERM; else trap 'exit 143' TERM; fi
      trap 'exit 130' INT
      while :; do /bin/sleep 1; done
    elif [ "${MOCK_APK_INSTALL:-ok}" = grant_flag_unsupported ] && [[ " $* " == *" -g "* ]]; then
      printf 'Error: Unknown option: -g\n' >&2
      exit 1
    elif [ "${MOCK_APK_INSTALL:-ok}" = grant_flag_unsupported ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      mark_hapaneld_stopped "${!#}"
      printf 'Success\n'
    elif [ "${MOCK_APK_INSTALL:-ok}" = ok ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      mark_hapaneld_stopped "${!#}"
      printf 'Success\n'
    elif [ "${MOCK_APK_INSTALL:-ok}" = ambiguous_commit ]; then
      cp "${!#}" "$STATE_DIR/installed-apk"
      mark_hapaneld_stopped "${!#}"
      printf 'error: transport closed after install request\n' >&2
      exit 1
    else
      printf '%s\n' "${MOCK_APK_INSTALL_OUTPUT:-Failure [INSTALL_FAILED_INSUFFICIENT_STORAGE]}"
      exit 1
    fi
    ;;
  disconnect)
    ;;
  shell)
    shift
    command_text="$*"
    case "$command_text" in
      *sha256sum*.hapaneld-db-observer.*-script*)
        /usr/bin/sha256sum "$STATE_DIR/db-observer-script.$ADB_TARGET" 2>/dev/null |
          awk '{print $1"  script"}'
        exit $? ;;
    esac
    if printf '%s' "$command_text" 2>/dev/null | grep -Fq 'HAPANELD_INSTALLER_DB_BEGIN'; then
      emit_legacy_installer_database_inventory
      exit 0
    fi
    if printf '%s' "$command_text" 2>/dev/null | grep -Fq 'HOSTDB_BEGIN'; then
      observer_remote="$(cat "$STATE_DIR/db-observer-remote.$ADB_TARGET" 2>/dev/null || true)"
      [ -n "$observer_remote" ] && [ -s "$STATE_DIR/db-observer-script.$ADB_TARGET" ] || exit 1
      printf '%s' "$command_text" 2>/dev/null | grep -Fq "sh $observer_remote " || exit 1
      grep -Fq '# HAPANELD_DB_COMPAT_OBSERVER_BEGIN' "$STATE_DIR/db-observer-script.$ADB_TARGET" || exit 1
      grep -Fq '# HAPANELD_DB_COMPAT_OBSERVER_END' "$STATE_DIR/db-observer-script.$ADB_TARGET" || exit 1
      ! grep -Eq '@(MINIMUM|MAXIMUM|PRIMARY_MODE|NONCE|OBSERVER_STAGE|OBSERVER_OWNER)@' "$STATE_DIR/db-observer-script.$ADB_TARGET" || exit 1
      emit_host_database_gate
      exit 0
    fi
    # Reclamation transport failure: the run's own outcome must not change, and the notice must be
    # honest about what happens next (the panel-side sweep removes the leftovers).
    if [ "${MOCK_STAGING_CLEANUP:-ok}" = fail ] &&
       printf '%s' "$command_text" 2>/dev/null | grep -Eq 'rm -f[^|]*(hapaneld-helper-[0-9a-f]{32}|\.helper-transaction-)'; then
      printf 'rm: permission denied\n' >&2
      exit 1
    fi
    model_device_adb_dir "$command_text"
    # Database-capture traffic is dialect-independent: intercept it whether it arrives bare
    # (SU_FORM=shell on adb-root panels) or su-wrapped, before any other dispatch.
    case "$command_text" in
      *'.hapaneld-db-txn.'*)
        handle_db_txn_command "$command_text"
        exit $? ;;
    esac
  case "$command_text" in
      "am broadcast --user 0 -a io.github.maxlyth.hapaneld.action.PREPARE_UPGRADE -n io.github.maxlyth.hapaneld/.UpgradeControlReceiver --es nonce "*)
        nonce="${command_text##*--es nonce }"
        case "${MOCK_UPGRADE_PREPARE:-unsupported}" in
          ready|size_mismatch|digest_mismatch|invalid_sqlite|schema_mismatch|rows_mismatch)
            prepare_db_txn_sandbox
            direct_db="$DB_TXN_SANDBOX/data/data/io.github.maxlyth.hapaneld/databases/ha-paneld.db"
            if [ "${MOCK_UPGRADE_PREPARE:-}" = invalid_sqlite ]; then
              printf 'not a sqlite database\n' > "$direct_db"
            fi
            bytes="$(wc -c < "$direct_db" | tr -d ' ')"
            sha="$(/usr/bin/sha256sum "$direct_db" | awk '{print $1}')"
            [ "${MOCK_UPGRADE_PREPARE:-}" != size_mismatch ] || bytes=$((bytes + 1))
            [ "${MOCK_UPGRADE_PREPARE:-}" != digest_mismatch ] || sha="$(printf '%064d' 0)"
            receipt_uv=9; receipt_rows=7
            [ "${MOCK_UPGRADE_PREPARE:-}" != schema_mismatch ] || receipt_uv=10
            [ "${MOCK_UPGRADE_PREPARE:-}" != rows_mismatch ] || receipt_rows=8
            printf 'Broadcast completed: result=-1, data="HAPANELD_UPGRADE_READY_V1:%s:4242:513:%s:%s:%s:%s"\n' \
              "$nonce" "$bytes" "$sha" "$receipt_uv" "$receipt_rows"
            ;;
          malformed)
