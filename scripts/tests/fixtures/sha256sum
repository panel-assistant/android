#!/usr/bin/env bash
set -u

printf 'sha256sum %s\n' "$*" >> "${MOCK_CALL_LOG:?MOCK_CALL_LOG is required}"

if [ "$#" -eq 0 ]; then
  exec /usr/bin/sha256sum
fi

case "${1:-}" in
  */shizuku.apk)
    printf '%s  %s\n' \
      "${MOCK_SHIZUKU_DOWNLOAD_SHA:-6e273ab0e991c4e79bc8b1bbb9b9dd739ccac1a8712a541a214078886b7b790f}" \
      "$1"
    ;;
  */installed.apk|*/ha-paneld*.apk|*/panel-assistant*.apk)
    /usr/bin/sha256sum "$1"
    ;;
  # The database-capture flow authenticates its own artifacts by digest; those hashes must be real
  # or every transfer verification is comparing against a manufactured constant.
  */hapaneld-db-observer.*|*.db-txn-script|*.break-glass.db|*/db-txn-sandbox/*)
    /usr/bin/sha256sum "$1"
    ;;
  *)
    # Installed-manager fixtures are intentionally not byte-identical to the curated APK. Returning
    # a deterministic non-match drives provisioning through its signing-certificate check without
    # depending on whether the test host provides GNU sha256sum or macOS shasum.
    printf '%064d  %s\n' 0 "${1:-mock.apk}"
    ;;
esac
digest_status=$?

# MOCK_HOST_DIGEST_VANISH=<glob>:<n> takes this host's digest tool away mid-run, so each host digest
# can be reached with no tool: once the n-th file matching <glob> has been hashed, the link this call
# came through is removed and the NEXT digest finds none. Only a link in a test-built host is ever
# removed, never this fixture itself.
if [ -n "${MOCK_HOST_DIGEST_VANISH:-}" ] && [ -L "$0" ]; then
  vanish_glob="${MOCK_HOST_DIGEST_VANISH%:*}"
  vanish_count_file="${MOCK_STATE_DIR:?MOCK_STATE_DIR is required}/host-digest-vanish-count"
  # shellcheck disable=SC2254
  case "${1:-}" in
    $vanish_glob)
      printf x >> "$vanish_count_file"
      [ "$(wc -c < "$vanish_count_file")" -lt "${MOCK_HOST_DIGEST_VANISH##*:}" ] || rm -f "$0"
      ;;
  esac
fi
exit "$digest_status"
