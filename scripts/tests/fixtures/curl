        ;;
      stable_newest) cat <<'JSON'
[
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/202",
    "tag_name": "v0.9.3",
    "draft": false,
    "prerelease": false,
    "assets": [{"browser_download_url": "https://github.com/maxlyth/ha-paneld/releases/download/v0.9.3/ha-paneld-v0.9.3-manual-setup-required.apk"}]
  },
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/201",
    "tag_name": "v0.9.2-rc3",
    "draft": false,
    "prerelease": true,
    "assets": [{"browser_download_url": "https://github.com/maxlyth/ha-paneld/releases/download/v0.9.2-rc3/ha-paneld-v0.9.2-rc3-manual-setup-required.apk"}]
  }
]
JSON
        ;;
      stable_only) cat <<'JSON'
[
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/202",
    "tag_name": "v0.9.3",
    "draft": false,
    "prerelease": false,
    "assets": [{"browser_download_url": "https://github.com/maxlyth/ha-paneld/releases/download/v0.9.3/ha-paneld-v0.9.3-manual-setup-required.apk"}]
  }
]
JSON
        ;;
      draft_newest) cat <<'JSON'
[
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/203",
    "tag_name": "v0.9.4-rc1",
    "draft": true,
    "prerelease": true,
    "assets": [{"browser_download_url": "https://github.com/maxlyth/ha-paneld/releases/download/v0.9.4-rc1/ha-paneld-v0.9.4-rc1-manual-setup-required.apk"}]
  },
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/202",
    "tag_name": "v0.9.3",
    "draft": false,
    "prerelease": false,
    "assets": [{"browser_download_url": "https://github.com/maxlyth/ha-paneld/releases/download/v0.9.3/ha-paneld-v0.9.3-manual-setup-required.apk"}]
  }
]
JSON
        ;;
      oversized)
        # Keep the selected prerelease small, then exceed typical pipe buffers with an older
        # release. An early-exiting consumer makes an upstream stage fail with SIGPIPE.
        printf '%s' '[{"url":"https://api.github.com/repos/maxlyth/ha-paneld/releases/201","tag_name":"v0.9.2-rc3","draft":false,"prerelease":true,"assets":[{"browser_download_url":"https://github.com/maxlyth/ha-paneld/releases/download/v0.9.2-rc3/ha-paneld-v0.9.2-rc3-manual-setup-required.apk"}]},{"url":"https://api.github.com/repos/maxlyth/ha-paneld/releases/200","tag_name":"v0.9.1","draft":false,"prerelease":false,"padding":"'
        awk 'BEGIN { for (i = 0; i < 2097152; i++) printf "x" }'
        printf '%s\n' '"}]'
        ;;
      foreign) cat <<'JSON'
[
  {
    "url": "https://api.github.com/repos/maxlyth/ha-paneld/releases/201",
    "tag_name": "v0.9.2-rc3",
    "draft": false,
    "prerelease": true,
    "assets": [{"browser_download_url": "https://downloads.test/ha-paneld-v0.9.2-rc3-manual-setup-required.apk"}]
  }
]
JSON
        ;;
      *) exit 22 ;;
    esac
    ;;
  https://api.github.com/repos/maxlyth/ha-paneld/releases/latest)
    case "${MOCK_INSTALLER_RELEASE_API:-fail}" in
      legacy) tag=v0.9.2 ;;
      authenticated) tag=v0.9.3 ;;
      *) exit 22 ;;
    esac
    printf '{"tag_name":"%s","assets":[{"browser_download_url":"https://github.com/maxlyth/ha-paneld/releases/download/%s/ha-paneld-%s-manual-setup-required.apk"}]}\n' "$tag" "$tag" "$tag"
    ;;
  https://github.com/maxlyth/ha-paneld/releases/download/v*/ha-paneld-v*-manual-setup-required.apk)
    [ -n "$output_file" ] || exit 2
    printf 'test apk\n' > "$output_file"
    ;;
  */auth/login_flow)
    [ "${MOCK_HA_LOGIN:-ok}" = "timeout" ] && exit 28
    [ "${MOCK_HA_LOGIN:-ok}" = "flow_fail" ] && exit 22
    printf '{"flow_id":"flow-1"}\n'
    ;;
  */auth/login_flow/*)
    [ "${MOCK_HA_LOGIN:-ok}" = "timeout" ] && exit 28
    [ "${MOCK_HA_LOGIN:-ok}" = "rejected" ] && printf '{"errors":{"base":"invalid_auth"}}\n' || printf '{"result":"auth-code"}\n'
    ;;
  */auth/token)
    [ "${MOCK_HA_LOGIN:-ok}" = "timeout" ] && exit 28
    if [ "${MOCK_HA_LOGIN:-ok}" = "token_missing" ]; then printf '{}\n';
    else printf '{"access_token":"access","refresh_token":"refresh","expires_in":1800}\n'; fi
    ;;
  */api/)
    [ "${MOCK_HA_TOKEN:-ok}" = "ok" ] || exit 22
    printf '{"message":"API running."}\n'
    ;;
  */health)
    # `slow` models the #74 shape: the agent is starting and answers only after N probes. It must be
    # a success, not a failure — the panels in that report were serving ~2 minutes later untouched.
    # BOUNDED hang: consumes the probe's --max-time and then returns, so the deadline overrun is
    # measurable without the suite inheriting an unbounded wait. An earlier unbounded version made
    # every health call in the run block and pushed the suite past ten minutes.
    if [ "${MOCK_HEALTH:-ok}" = "hang" ]; then
      case "$max_time" in ''|*[!0-9]*|0) exit 2 ;; esac
      hang_seconds="${MOCK_HEALTH_HANG_SECONDS:-30}"
      case "$hang_seconds" in ''|*[!0-9]*|0) exit 2 ;; esac
      [ "$hang_seconds" -ge "$max_time" ] || exit 2
      /bin/sleep "$max_time" &
      sleep_pid=$!
      if [ -n "${MOCK_HEALTH_HANG_PID_FILE:-}" ]; then
        printf '%s %s %s\n' "$$" "$sleep_pid" "$max_time" >> "$MOCK_HEALTH_HANG_PID_FILE"
      fi
      wait "$sleep_pid"
      if [ -n "${MOCK_HEALTH_HANG_DONE_FILE:-}" ]; then
        printf '%s %s %s\n' "$$" "$sleep_pid" "$max_time" >> "$MOCK_HEALTH_HANG_DONE_FILE"
      fi
      exit 28
    fi
    if [ "${MOCK_HEALTH:-ok}" = "slow" ]; then
      probe_file="${MOCK_STATE_DIR:?}/health-probes"
      probes=0; [ ! -f "$probe_file" ] || probes="$(cat "$probe_file")"
      probes=$((probes + 1)); printf '%s\n' "$probes" > "$probe_file"
      [ "$probes" -ge "${MOCK_HEALTH_READY_AFTER:-3}" ] || exit 22
    else
      [ "${MOCK_HEALTH:-ok}" = "ok" ] || exit 22
    fi
    if [ "${MOCK_STOPPED_STATE:-0}" = 1 ] && [ -f "${MOCK_STATE_DIR:?}/package-stopped" ]; then
      exit 22
    fi
    printf 'ha-paneld test health\n'
    ;;
  */api/v1/power-safety/state)
    case "${MOCK_POWER_SAFETY:-safe}" in
      missing) exit 22 ;;
      malformed) emit_body '{' ;;
      truncated-safe) emit_body 'safe{' ;;
      garbage-safe) emit_body 'garbage safe' ;;
      duplicate-safe) emit_body 'safe safe' ;;
      control-safe) emit_body 's\033afe\n' ;;
      nul-safe) emit_body 's\000afe\n' ;;
      *) emit_body '%s\n' "${MOCK_POWER_SAFETY:-safe}" ;;
    esac
    ;;
  */api/v1/status|*/api/v1/status\?database_observation_nonce=*)
    storage_health="${MOCK_STORAGE_HEALTH:-healthy}"
    power_safety="${MOCK_POWER_SAFETY:-safe}"
    database_json=',"schema_version":'"${MOCK_STATUS_DB_SCHEMA:-${MOCK_DB_DEVICE_USER_VERSION:-9}}"',"quick_check":"'"${MOCK_STATUS_DB_QUICK_CHECK:-ok}"'"'
    case "${MOCK_STATUS_DB_FIELDS:-exact}" in
      duplicate_schema) database_json="$database_json"',"schema_version":'"${MOCK_STATUS_DB_SCHEMA:-14}" ;;
      duplicate_quick) database_json="$database_json"',"quick_check":"'"${MOCK_STATUS_DB_QUICK_CHECK:-ok}"'"' ;;
    esac
    observation_json=''
    case "$url" in
      *\?database_observation_nonce=*)
        observation_nonce="${url##*database_observation_nonce=}"
        case "${MOCK_STATUS_DB_NONCE:-exact}" in
          exact) observation_json=',"database_observation_nonce":"'"$observation_nonce"'"' ;;
          missing) observation_json='' ;;
          wrong) observation_json=',"database_observation_nonce":"00000000000000000000000000000000"' ;;
          malformed) observation_json=',"database_observation_nonce":"not-a-nonce"' ;;
          duplicate) observation_json=',"database_observation_nonce":"'"$observation_nonce"'","database_observation_nonce":"'"$observation_nonce"'"' ;;
          *) observation_json=',"database_observation_nonce":"'"$MOCK_STATUS_DB_NONCE"'"' ;;
        esac ;;
    esac
    case "$power_safety" in
      missing) power_json="" ;;
      malformed) power_json=',"power_safety":{' ;;
      *) power_json=',"power_safety":{"state":"'"$power_safety"'","summary":"fixture power summary","action":"fixture power action"}' ;;
    esac
    case "$storage_health" in
      transport-fail) exit 22 ;;
      legacy|legacy-json) printf '{"version":"legacy fixture"}\n' ;;
      malformed) printf '{"storage_health":' ;;
      unchecked-then-healthy)
        attempts_file="${MOCK_STATE_DIR:?}/storage-status-attempts"
        attempts=0
        [ ! -f "$attempts_file" ] || attempts="$(cat "$attempts_file")"
        attempts=$((attempts + 1))
        printf '%s\n' "$attempts" > "$attempts_file"
        if [ "$attempts" -lt 3 ]; then
          printf '{"storage_health":{"state":"unchecked"%s}%s%s}\n' "$database_json" "$observation_json" "$power_json"
        else
          printf '{"storage_health":{"state":"healthy"%s}%s%s}\n' "$database_json" "$observation_json" "$power_json"
