      healthy-then-critical|healthy-then-database_failure)
        attempts_file="${MOCK_STATE_DIR:?}/storage-status-attempts"
        attempts=0
        [ ! -f "$attempts_file" ] || attempts="$(cat "$attempts_file")"
        attempts=$((attempts + 1))
        printf '%s\n' "$attempts" > "$attempts_file"
        if [ "$attempts" -eq 1 ]; then
          next_health=healthy
        else
          next_health="${storage_health#healthy-then-}"
        fi
        printf '{"storage_health":{"state":"%s","summary":"fixture storage summary","action":"fixture storage action"%s}%s%s}\n' \
          "$next_health" "$database_json" "$observation_json" "$power_json"
        ;;
      always-unchecked) printf '{"storage_health":{"state":"unchecked"}%s}\n' "$power_json" ;;
      healthy|unchecked|warning|critical|database_failure)
        printf '{"storage_health":{"state":"%s","summary":"fixture storage summary","action":"fixture storage action"%s}%s%s}\n' \
          "$storage_health" "$database_json" "$observation_json" "$power_json"
