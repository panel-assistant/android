#!/usr/bin/env bash
# Offline multi-call fixture for install_legacy_database_gate_test.sh.
set -u

state_dir="${INSTALL_LEGACY_STATE_DIR:?INSTALL_LEGACY_STATE_DIR is required}"
mkdir -p "$state_dir"

next_count() {
  local name="$1" file="$state_dir/$1.count" count=0
  [ ! -f "$file" ] || read -r count < "$file"
  count=$((count + 1))
  printf '%s\n' "$count" > "$file"
  printf '%s\n' "$count"
}

known_su_form() {
  local wanted="$1"
  case "${MOCK_INSTALL_SU_FORM:-shell}" in
    shell) [ "$wanted" = shell ] ;;
    su0join) [ "$wanted" = 'su 0 join' ] ;;
    su0shc) [ "$wanted" = 'su 0 shc' ] ;;
    surootjoin) [ "$wanted" = 'su root join' ] ;;
    surootshc) [ "$wanted" = 'su root shc' ] ;;
    suc) [ "$wanted" = suc ] ;;
    *) return 1 ;;
  esac
}

selected_state() {
  local prefix="$1" count="$2" initial final
  eval "initial=\${${prefix}_INITIAL:-fresh}"
  eval "final=\${${prefix}_FINAL:-\$initial}"
  if [ "$count" -eq 1 ]; then printf '%s\n' "$initial"; else printf '%s\n' "$final"; fi
}

emit_package_observation() {
  local command="$1" nonce count state target_rc=1 data_rc=0 probe_pkg
  nonce="$(printf '%s\n' "$command" | sed -n 's/.*HAPANELD_INSTALLER_PKG_BEGIN:\([0-9a-f]\{32\}\).*/\1/p')"
  [ -n "$nonce" ] || exit 2
  probe_pkg="$(printf '%s\n' "$command" | sed -n 's/^[^;]*; *pm path \([^;]*\);.*/\1/p' | head -1)"
  if [ "$probe_pkg" != "io.panelassistant.android" ]; then
    printf 'HAPANELD_INSTALLER_PKG_BEGIN:%s\n' "$nonce"
    printf 'HAPANELD_INSTALLER_PKG_TARGET:%s:1\n' "$nonce"
    printf 'HAPANELD_INSTALLER_DATA:%s:0\n' "$nonce"
    printf 'package:/system/framework/framework-res.apk\n'
    printf 'HAPANELD_INSTALLER_PKG_LIVE:%s:0\n' "$nonce"
    printf 'HAPANELD_INSTALLER_PKG_END:%s\n' "$nonce"
    return 0
  fi
  count="$(next_count package)"
  state="$(selected_state MOCK_INSTALL_PACKAGE "$count")"
  [ "$state" != transport-fail ] || exit 1
  printf 'HAPANELD_INSTALLER_PKG_BEGIN:%s\n' "$nonce"
  case "$state" in
    present)
      printf 'package:/data/app/%s/base.apk\n' "$probe_pkg"
      target_rc=0
      ;;
    absent|retained) target_rc=1 ;;
    malformed)
      printf 'package:data/app/%s/base.apk\n' "$probe_pkg"
      target_rc=0
      ;;
    target-failed) target_rc=137 ;;
    noise)
      printf 'unexpected package-manager output\n'
      target_rc=1
      ;;
    marker-junk) target_rc=1 ;;
    *) exit 2 ;;
  esac
  if [ "$state" = marker-junk ]; then
    printf 'HAPANELD_INSTALLER_PKG_TARGET:%s:%s:junk\n' "$nonce" "$target_rc"
  else
    printf 'HAPANELD_INSTALLER_PKG_TARGET:%s:%s\n' "$nonce" "$target_rc"
  fi
  [ "$state" != retained ] || printf 'package:%s\n' "$probe_pkg"
  printf 'HAPANELD_INSTALLER_DATA:%s:%s\n' "$nonce" "$data_rc"
  printf 'package:/system/framework/framework-res.apk\n'
  printf 'HAPANELD_INSTALLER_PKG_LIVE:%s:0\n' "$nonce"
  printf 'HAPANELD_INSTALLER_PKG_END:%s\n' "$nonce"
}

emit_root_inventory() {
  local command="$1" nonce count state sandbox transformed output status=0 execute_uid execute_prefix=""
  nonce="$(printf '%s\n' "$command" | sed -n 's/.*HAPANELD_INSTALLER_DB_BEGIN:\([0-9a-f]\{32\}\).*/\1/p')"
  [ -n "$nonce" ] || exit 2
  count="$(next_count root-data)"
  state="$(selected_state MOCK_INSTALL_ROOT_DATA "$count")"
  sandbox="$state_dir/rootfs-$count"
  mkdir -p "$sandbox/user0" "$sandbox/userde"
  ln -s "$sandbox/user0" "$sandbox/data-data"
  case "$state" in
    fresh) ;;
    app-data) mkdir -p "$sandbox/user0/io.github.maxlyth.hapaneld" ;;
    database)
      mkdir -p "$sandbox/user0/io.github.maxlyth.hapaneld/databases"
      printf 'database\n' > "$sandbox/user0/io.github.maxlyth.hapaneld/databases/ha-paneld.db"
      ;;
    recovery)
      mkdir -p "$sandbox/user0/io.github.maxlyth.hapaneld/databases"
      printf 'recovery\n' > "$sandbox/user0/io.github.maxlyth.hapaneld/databases/ha-paneld.db.v14.premigrate"
      ;;
    de-recovery)
      mkdir -p "$sandbox/userde/io.github.maxlyth.hapaneld/databases"
      printf 'recovery\n' > "$sandbox/userde/io.github.maxlyth.hapaneld/databases/ha-paneld.db.v14.premigrate"
      ;;
    recovery-symlink)
      mkdir -p "$sandbox/user0/io.github.maxlyth.hapaneld/databases"
      ln -s missing "$sandbox/user0/io.github.maxlyth.hapaneld/databases/ha-paneld.db.v14.premigrate"
      ;;
    unreadable)
      rmdir "$sandbox/user0"
      printf 'not a directory\n' > "$sandbox/user0"
      ;;
    missing-ce)
      unlink "$sandbox/data-data"
      rmdir "$sandbox/user0"
      ;;
    missing-data-data) unlink "$sandbox/data-data" ;;
    missing-de) rmdir "$sandbox/userde" ;;
    fail) exit 1 ;;
    malformed|noise|root-marker-unknown) ;;
    *) exit 2 ;;
  esac
  transformed="${command//\/data\/user\/0/$sandbox\/user0}"
  transformed="${transformed//\/data\/user_de\/0/$sandbox\/userde}"
  transformed="${transformed//\/data\/data/$sandbox\/data-data}"
  execute_uid="$(selected_state MOCK_INSTALL_ROOT_EXEC_UID "$count")"
  case "$execute_uid" in
    rooted) execute_prefix='id() { printf "%s\n" "uid=0(root) gid=0(root)"; }' ;;
    unrooted) execute_prefix='id() { printf "%s\n" "uid=2000(shell) gid=2000(shell)"; }' ;;
    *) exit 2 ;;
  esac
  output="$(bash -c "$execute_prefix
$transformed")" || status=$?
  [ "$status" -eq 0 ] || exit "$status"
  printf '%s\n' "$output" >> "$state_dir/root-observations.log"
  case "$state" in
    malformed) printf '%s\n' "$output" | sed '/^HAPANELD_INSTALLER_DB_END:/d' ;;
    noise)
      printf 'unexpected root observer output\n'
      printf '%s\n' "$output"
      ;;
    root-marker-unknown) printf '%s\n' "$output" | sed 's/^HAPANELD_INSTALLER_ROOT_UID:zero$/HAPANELD_INSTALLER_ROOT_UID:unknown/' ;;
    *) printf '%s\n' "$output" ;;
  esac
}

current_root_route() {
  local count=1
  [ ! -f "$state_dir/package.count" ] || read -r count < "$state_dir/package.count"
  selected_state MOCK_INSTALL_ROOT_ROUTE "$count"
}

mock_adb() {
  local command="${*: -1}" root_route dispatch
  dispatch="$command"
  printf 'adb %s\n' "$*" >> "$state_dir/calls.log"
  case "$command" in
    *HAPANELD_INSTALLER_PKG_BEGIN:*) emit_package_observation "$command" ;;
    *HAPANELD_INSTALLER_DB_BEGIN:*)
      root_route="$(current_root_route)"
      [ "$root_route" = rooted ] || exit 1
      case "$command" in
        'su 0 sh -c '* ) known_su_form 'su 0 shc' || exit 1; dispatch="${command#su 0 sh -c }" ;;
        'su 0 '* ) known_su_form 'su 0 join' || exit 1; dispatch="${command#su 0 }" ;;
        'su root sh -c '* ) known_su_form 'su root shc' || exit 1; dispatch="${command#su root sh -c }" ;;
        'su root '* ) known_su_form 'su root join' || exit 1; dispatch="${command#su root }" ;;
        'su -c '* ) known_su_form suc || exit 1; dispatch="${command#su -c }" ;;
        * ) known_su_form shell || exit 1 ;;
      esac
      [ "${dispatch#\"}" = "$dispatch" ] || dispatch="${dispatch#\"}"
      [ "${dispatch%\"}" = "$dispatch" ] || dispatch="${dispatch%\"}"
      dispatch="${dispatch//\\\$/\$}"
      dispatch="${dispatch//\\\`/\`}"
      dispatch="${dispatch//\\\"/\"}"
      dispatch="${dispatch//\\\\/\\}"
      emit_root_inventory "$dispatch"
      ;;
    id)
      root_route="$(current_root_route)"
      if [ "$root_route" = rooted ] && known_su_form shell; then
        printf 'uid=0(root) gid=0(root)\n'
      else
        printf 'uid=2000(shell) gid=2000(shell)\n'
      fi
      ;;
    'su 0 "id; id"')
      root_route="$(current_root_route)"
      [ "$root_route" = rooted ] && known_su_form 'su 0 join' || exit 1
      printf 'uid=0(root) gid=0(root)\nuid=0(root) gid=0(root)\n'
      ;;
    'su 0 sh -c "id; id"')
      root_route="$(current_root_route)"
      [ "$root_route" = rooted ] && known_su_form 'su 0 shc' || exit 1
      printf 'uid=0(root) gid=0(root)\nuid=0(root) gid=0(root)\n'
      ;;
    'su root "id; id"')
      root_route="$(current_root_route)"
      [ "$root_route" = rooted ] && known_su_form 'su root join' || exit 1
      printf 'uid=0(root) gid=0(root)\nuid=0(root) gid=0(root)\n'
      ;;
    'su root sh -c "id; id"')
      root_route="$(current_root_route)"
      [ "$root_route" = rooted ] && known_su_form 'su root shc' || exit 1
      printf 'uid=0(root) gid=0(root)\nuid=0(root) gid=0(root)\n'
      ;;
    'su -c "id; id"')
      root_route="$(current_root_route)"
      [ "$root_route" = rooted ] && known_su_form suc || exit 1
      printf 'uid=0(root) gid=0(root)\nuid=0(root) gid=0(root)\n'
      ;;
    *) printf 'unexpected adb command: %s\n' "$command" >&2; exit 2 ;;
  esac
}

write_curl_output() {
  local output="$1"
  if [ -n "$output" ]; then
    cat > "$output"
  else
    cat
  fi
}

emit_provisioner() {
  printf '%s\n' '#!/usr/bin/env bash'
  [ "${MOCK_INSTALL_CURRENT_PROVISIONER:-0}" != 1 ] || printf '%s\n' '# HAPANELD_HOST_DB_GATE_V1'
  cat <<'EOF'
set -u
printf 'provisioner-executed\n' >> "$INSTALL_LEGACY_STATE_DIR/events.log"
printf '%s\n' "$*" >> "$INSTALL_LEGACY_STATE_DIR/provisioner-args.log"
exit 0
EOF
}

mock_curl() {
  local output="" want_output=0 url="" arg
  for arg in "$@"; do
    if [ "$want_output" = 1 ]; then output="$arg"; want_output=0; continue; fi
    case "$arg" in
      -o|--output) want_output=1 ;;
      https://*) url="$arg" ;;
    esac
  done
  printf 'curl %s\n' "$url" >> "$state_dir/calls.log"
  case "$url" in
    https://api.github.com/repos/panel-assistant/android/releases/latest)
      printf '%s\n' '{"tag_name":"v0.9.2","browser_download_url":"https://github.com/panel-assistant/android/releases/download/v0.9.2/ha-paneld-v0.9.2-manual-setup-required.apk"}' | write_curl_output "$output"
      ;;
    https://raw.githubusercontent.com/panel-assistant/android/v0.9.2/scripts/provision.sh)
      emit_provisioner | write_curl_output "$output"
      ;;
    https://github.com/panel-assistant/android/releases/download/v0.9.2/ha-paneld-v0.9.2-manual-setup-required.apk)
      printf 'fixture apk\n' | write_curl_output "$output"
      ;;
    *) printf 'unexpected curl URL: %s\n' "$url" >&2; exit 22 ;;
  esac
}

case "${0##*/}" in
  adb) mock_adb "$@" ;;
  curl) mock_curl "$@" ;;
  openssl)
    [ "${1:-}" = version ] || { printf 'unexpected openssl invocation: %s\n' "$*" >&2; exit 2; }
    printf 'OpenSSL fixture\n'
    ;;
  *) printf 'unexpected fixture name: %s\n' "${0##*/}" >&2; exit 2 ;;
esac
