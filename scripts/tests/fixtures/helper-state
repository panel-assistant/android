#!/usr/bin/env bash
# Stateful root-helper model used by the focused managed-provision tests.  It deliberately models
# only device state which is authoritative for replacement: the sealed live inode, the one boot
# registration, the supervised process, Guard phase/residue, and the open helper transaction.
set -u

STATE_DIR="${MOCK_STATE_DIR:?MOCK_STATE_DIR is required}"
MODEL="$STATE_DIR/helper-model"
VALUES="$MODEL/values"
BOOT="$MODEL/boot"
CAPTURED="$MODEL/captured"
TXN="$MODEL/transaction"

CAPS='OK GUARDCAPS 1 PREPARE DEFINE STREAM ACTION HEALTH REFUSAL STATUS EVIDENCE CANCEL RETIRE JOURNAL AUTONOMOUS SUPERVISED TERMINAL_RETIRE'
EMPTY_STATUS='OK GUARDSTATUS 0 EMPTY NONE NONE NONE NONE 0 0 0 NONE NONE 0 0'

die() { printf 'helper-state: %s\n' "$*" >&2; exit 2; }
valid_word() { case "$1" in ''|*[!0-9A-Za-z._:/+-]*) return 1 ;; *) return 0 ;; esac; }
ensure_model() { mkdir -p "$VALUES" "$BOOT" "$CAPTURED"; }
put() { valid_word "$1" || die "invalid key"; printf '%s\n' "$2" > "$VALUES/$1"; }
get() { valid_word "$1" || die "invalid key"; if [ -f "$VALUES/$1" ]; then sed -n '1p' "$VALUES/$1"; else printf '%s\n' "${2:-}"; fi; }
event() { ensure_model; printf '%s\n' "$*" >> "$MODEL/events"; }

clear_model() {
  case "$MODEL" in "$STATE_DIR"/helper-model) rm -rf "$MODEL" ;; *) die "unsafe model path" ;; esac
  ensure_model
}

write_boot() {
  kind="$1" path="$2"
  rm -f "$BOOT/system.rc" "$BOOT/vendor.rc" "$BOOT/service.sh"
  case "$kind" in
    system)
      printf 'service hapaneld_helper %s --supervise\n    class main\n    user root\n    group root\n    seclabel u:r:su:s0\n' "$path" > "$BOOT/system.rc" ;;
    hybrid)
      printf 'service hapaneld_helper %s --supervise\n    class main\n    user root\n    group root\n    seclabel u:r:su:s0\n' "$path" > "$BOOT/vendor.rc" ;;
    systemless)
      printf '#!/system/bin/sh\nwhile [ "$(getprop sys.boot_completed)" != "1" ]; do sleep 3; done\n/system/bin/stop hapaneld_helper 2>/dev/null\n/system/bin/stop hapaneld_ledd 2>/dev/null\n/system/bin/pkill -x hapaneld-helper 2>/dev/null\n/system/bin/pkill -x hapaneld-ledd 2>/dev/null\n%s --supervise >/dev/null 2>&1 &\n' "$path" > "$BOOT/service.sh" ;;
    none) ;;
    *) die "invalid boot kind: $kind" ;;
  esac
  put boot.kind "$kind"
}

seed() {
  [ "$#" -ge 3 ] || die 'seed KIND LIVE_PATH BUILD_ID [GUARD_PHASE] [SUPERVISORS]'
  kind="$1" path="$2" build="$3" guard="${4:-EMPTY}" supervisors="${5:-1}"
  case "$kind" in system|systemless|hybrid|none) ;; *) die "invalid kind: $kind" ;; esac
  case "$path" in /*) ;; *) die "live path is not absolute: $path" ;; esac
  printf '%s\n' "$build" 2>/dev/null | grep -Eq '^[0-9a-f]{64}$' || die 'BUILD_ID must be 64 lowercase hex characters'
  case "$supervisors" in ''|*[!0-9]*) die 'SUPERVISORS must be numeric' ;; esac
  clear_model
  put live.path "$path"
  put live.build "$build"
  put live.sha "$build"
  put live.mode 0700
  put live.owner 0:0
  put live.nlink 1
  put guard.phase "$guard"
  if [ "$guard" = EMPTY ]; then put guard.residue 0; else put guard.residue 1; fi
  put process.supervisors "$supervisors"
  put process.workers "$supervisors"
  put process.path "$path"
  put process.build "$build"
  put launch.attempts 0
  put request.count 0
  put ready.after "${MOCK_HELPER_READY_AFTER:-0}"
  write_boot "$kind" "$path"
  event "SEED kind=$kind path=$path build=$build guard=$guard supervisors=$supervisors"
}

capture() {
  [ "$#" -eq 2 ] || die 'capture SOURCE REMOTE'
  source_file="$1" remote="$2"
  [ -f "$source_file" ] || die "capture source is not a file: $source_file"
  case "$remote" in
    /data/local/tmp/hapaneld-helper-*.rc) slot=rc ;;
    /data/local/tmp/hapaneld-helper-*.hrc) slot=hrc ;;
    /data/local/tmp/hapaneld-helper-*.svc) slot=svc ;;
    /data/local/tmp/hapaneld-helper-*.txn) slot=txn ;;
    /data/local/tmp/hapaneld-helper-*) slot=helper ;;
    *) return 0 ;;
  esac
  ensure_model
  cp "$source_file" "$CAPTURED/$slot"
  printf '%s\n' "$remote" > "$CAPTURED/$slot.remote"
  event "CAPTURE slot=$slot remote=$remote"
}

captured_build() {
  [ -f "$CAPTURED/helper" ] || return 1
  # Test helper assets state their identity through the same BUILDID token used by production.
  sed -nE 's/^BUILDID ([0-9a-f]{64})$/\1/p' "$CAPTURED/helper" | head -1
}

validate_boot_asset() {
  kind="$1"
  case "$kind" in
    system) asset="$CAPTURED/rc"; expected='service hapaneld_helper /data/local/hapaneld-helper --supervise' ;;
    hybrid) asset="$CAPTURED/hrc"; expected='service hapaneld_helper /data/local/hapaneld-helper --supervise' ;;
    systemless) asset="$CAPTURED/svc"; expected='/data/local/hapaneld-helper --supervise >/dev/null 2>&1 &' ;;
    *) return 1 ;;
  esac
  [ -f "$asset" ] || return 1
  [ "$(grep -Fxc "$expected" "$asset" 2>/dev/null || true)" = 1 ] || return 1
  # Neither alternate binary is allowed to remain an authority in target boot bytes.
  ! grep -Eq '/system/bin/hapaneld-helper|/data/adb/hapaneld/hapaneld-helper' "$asset"
}

validate_transaction_asset() {
  [ -f "$CAPTURED/txn" ] || return 1
  [ "$(grep -Fc '    echo JOURNAL_VERSION=2' "$CAPTURED/txn")" = 3 ] || return 1
  helper_sha="$(sha256sum "$CAPTURED/helper" | awk '{print $1}')"
  grep -Fq "TARGET_HELPER_SHA256=$helper_sha" "$CAPTURED/txn" || return 1
  grep -Fq 'GUARD_ARMED' "$CAPTURED/txn" || return 1
  grep -Fq 'REPLACE_SAFE' "$CAPTURED/txn" || return 1
  [ "$(grep -c -- '--replacement-safe' "$CAPTURED/txn")" -ge 1 ] || return 1
  [ "$(grep -Ec 'mv -f .* /data/local/hapaneld-helper([ ;]|$)' "$CAPTURED/txn")" = 3 ] || return 1
  safety_line="$(grep -n -- '--replacement-safe' "$CAPTURED/txn" | head -1 | cut -d: -f1)"
  canonical_line="$(grep -nE 'mv -f .* /data/local/hapaneld-helper([ ;]|$)' "$CAPTURED/txn" | head -1 | cut -d: -f1)"
  case "$safety_line:$canonical_line" in *[!0-9:]*) return 1 ;; esac
  [ -n "$safety_line" ] && [ -n "$canonical_line" ] && [ "$safety_line" -lt "$canonical_line" ]
}

snapshot() {
  rm -rf "$TXN"
  mkdir -p "$TXN/values" "$TXN/boot"
  cp -a "$VALUES/." "$TXN/values/"
  cp -a "$BOOT/." "$TXN/boot/"
}

replacement_safe() {
  phase="$(get guard.phase EMPTY)" residue="$(get guard.residue 0)"
  if [ "$phase" = EMPTY ] && [ "$residue" = 0 ]; then
    printf 'REPLACE_SAFE\n'
    event 'REPLACEMENT_SAFE result=REPLACE_SAFE'
    return 0
  fi
  printf 'GUARD_ARMED\n'
  event "REPLACEMENT_SAFE result=GUARD_ARMED phase=$phase residue=$residue"
  return 3
}

install() {
  case "$#" in 1|5) ;; *) die 'install KIND [TRANSACTION_ID APK_SHA BUILD_ID HELPER_SHA]' ;; esac
  kind="$1"
  [ -f "$CAPTURED/helper" ] && [ -f "$CAPTURED/txn" ] || { printf 'INSTALL_INVALID\n'; event 'INSTALL_INVALID missing-assets'; return 1; }
  build="$(captured_build)"
  printf '%s\n' "$build" 2>/dev/null | grep -Eq '^[0-9a-f]{64}$' || { printf 'INSTALL_INVALID\n'; event 'INSTALL_INVALID build'; return 1; }
  validate_boot_asset "$kind" || { printf 'INSTALL_INVALID\n'; event "INSTALL_INVALID boot=$kind"; return 1; }
  validate_transaction_asset || { printf 'INSTALL_INVALID\n'; event 'INSTALL_INVALID transaction-contract'; return 1; }
  snapshot
  put transaction.open 1
  put transaction.kind "$kind"
  put transaction.target_build "$build"
  if [ "$#" -eq 5 ]; then
    printf '%s\n' "$2" 2>/dev/null | grep -Eq '^[0-9a-f]{32}$' || die 'transaction id must be 32 lowercase hex characters'
    for identity in "$3" "$4" "$5"; do
      printf '%s\n' "$identity" 2>/dev/null | grep -Eq '^[0-9a-f]{64}$' || die 'transaction identity must be 64 lowercase hex characters'
    done
    [ "$4" = "$build" ] || die 'transaction BUILDID disagrees with captured helper'
    [ "$5" = "$(sha256sum "$CAPTURED/helper" | awk '{print $1}')" ] || die 'transaction helper hash disagrees with captured helper'
    put transaction.id "$2"
    put transaction.target_apk "$3"
    put transaction.target_build "$4"
    put transaction.target_helper "$5"
  fi
  # The shipped transaction journals and retires the incumbent before executing the staged
  # candidate's replacement-safe probe.  A refusal therefore leaves a recoverable transaction;
  # the host must drive rollback, whose final fingerprint is exactly the pre-attempt state.
  stop_processes
  replacement_safe >/dev/null || { status=$?; printf 'GUARD_ARMED\n'; return "$status"; }
  put live.path /data/local/hapaneld-helper
  put live.build "$build"
  put live.sha "$(sha256sum "$CAPTURED/helper" | awk '{print $1}')"
  put live.mode 0700
  put live.owner 0:0
  put live.nlink 1
  put guard.phase EMPTY
  put guard.residue 0
  case "$kind" in
    system) cp "$CAPTURED/rc" "$BOOT/system.rc"; rm -f "$BOOT/vendor.rc" "$BOOT/service.sh" ;;
    hybrid) cp "$CAPTURED/hrc" "$BOOT/vendor.rc"; rm -f "$BOOT/system.rc" "$BOOT/service.sh" ;;
    systemless) cp "$CAPTURED/svc" "$BOOT/service.sh"; rm -f "$BOOT/system.rc" "$BOOT/vendor.rc" ;;
    *) printf 'INSTALL_INVALID\n'; return 1 ;;
  esac
  put boot.kind "$kind"
  event "INSTALL_OK kind=$kind build=$build path=/data/local/hapaneld-helper"
  printf 'INSTALL_OK\n'
}

transaction_record() {
  case "$#" in 1|5) ;; *) die 'record KIND [TRANSACTION_ID APK_SHA BUILD_ID HELPER_SHA]' ;; esac
  record_kind="$1"
  [ "$(get transaction.open 0)" = 1 ] && [ "$(get transaction.kind none)" = "$record_kind" ] || return 1
  record_id="$(get transaction.id NONE)"
  record_apk="$(get transaction.target_apk NONE)"
  record_build="$(get transaction.target_build NONE)"
  record_helper="$(get transaction.target_helper NONE)"
  if [ "$#" -eq 5 ]; then
    [ "$2" = "$record_id" ] && [ "$3" = "$record_apk" ] && [ "$4" = "$record_build" ] && [ "$5" = "$record_helper" ] || {
      event "STATUS_ERR kind=$record_kind reason=identity"
      return 1
    }
    event "STATUS_OK kind=$record_kind state=TARGET"
  else
    event "DISCOVER_OK kind=$record_kind state=TARGET"
  fi
  printf 'JOURNAL_VERSION=2\n'
  printf 'JOURNAL_SCOPE=APK_HELPER\n'
  printf 'TRANSACTION_ID=%s\n' "$record_id"
  printf 'TARGET_APK_SHA256=%s\n' "$record_apk"
  printf 'TARGET_BUILD_ID=%s\n' "$record_build"
  printf 'TARGET_HELPER_SHA256=%s\n' "$record_helper"
  printf 'BOOT_KIND=%s\n' "$record_kind"
  printf 'LIVE_STATE=TARGET\n'
}

rollback() {
  [ -d "$TXN/values" ] || { printf 'ROLLBACK_INVALID\n'; return 1; }
  rm -rf "$VALUES" "$BOOT"
  mkdir -p "$VALUES" "$BOOT"
  cp -a "$TXN/values/." "$VALUES/"
  cp -a "$TXN/boot/." "$BOOT/"
  rm -rf "$TXN"
  rm -f "$STATE_DIR/active-helper-transaction"
  event 'ROLLBACK_RESTARTED'
  printf 'ROLLBACK_RESTARTED\n'
}

commit() {
  [ "$(get transaction.open 0)" = 1 ] || { printf 'COMMIT_INVALID\n'; return 1; }
  rm -rf "$TXN"
  put transaction.open 0
  rm -f "$STATE_DIR/active-helper-transaction"
  event 'COMMIT_OK'
  printf 'COMMIT_OK\n'
}

launch() {
  [ "$#" -eq 2 ] || die 'launch PATH supervised|plain'
  path="$1" mode="$2"
  [ "$path" = "$(get live.path NONE)" ] || { event "LAUNCH_REFUSED path=$path reason=not-live"; return 1; }
  attempts=$(( $(get launch.attempts 0) + 1 ))
  put launch.attempts "$attempts"
  if [ "$mode" != supervised ]; then
    event "LAUNCH_REFUSED path=$path reason=not-supervised"
    return 1
  fi
  # Starting a second supervisor is an authority violation, never a harmless retry.
  [ "$(get process.supervisors 0)" = 0 ] || { event "LAUNCH_REFUSED path=$path reason=duplicate"; return 1; }
  put process.supervisors 1
  put process.workers 1
  put process.path "$path"
  put process.build "$(get live.build NONE)"
  put request.count 0
  if [ "${MOCK_STATEFUL_DUPLICATE_ON_LAUNCH:-0}" = 1 ]; then
    put process.supervisors 2
    put process.workers 2
    event "LAUNCH_MUTANT duplicate-authority path=$path"
  fi
  event "LAUNCH_OK path=$path supervised=1 attempt=$attempts"
}

stop_processes() {
  put process.supervisors 0
  put process.workers 0
  put process.path NONE
  put process.build NONE
  event 'PROCESS_STOP'
}

request() {
  [ "$#" -eq 2 ] || die 'request PATH VERB'
  path="$1" verb="$2"
  count=$(( $(get request.count 0) + 1 )); put request.count "$count"
  case "$path" in
    /data/adb/hapaneld/.helper-probe-[0-9a-f]*)
      [ -f "$CAPTURED/helper" ] || { printf 'ERR\n'; return 1; }
      case "$verb" in
        PING) printf 'OK\n' ;;
        BUILDID) printf 'BUILDID %s\n' "$(captured_build)" ;;
        COMPANIONCAPS) printf 'COMPANIONCAPS 1 BACKUP RESTORE STATUS JOURNAL\n' ;;
        GUARDCAPS) printf '%s\n' "$CAPS" ;;
        GUARDSTATUS)
          if [ "$(get guard.phase EMPTY)" = EMPTY ] && [ "$(get guard.residue 0)" = 0 ]; then printf '%s\n' "$EMPTY_STATUS"
          else printf 'OK GUARDSTATUS 1 %s NONE NONE NONE NONE 0 0 0 NONE NONE 0 0\n' "$(get guard.phase UNKNOWN)"; fi ;;
        *) printf 'ERR\n'; return 1 ;;
      esac
      event "REQUEST_OK verb=$verb probe=1"
      return 0 ;;
  esac
  [ "$(get process.supervisors 0)" = 1 ] && [ "$(get process.workers 0)" = 1 ] || { printf 'ERR\n'; event "REQUEST_ERR verb=$verb reason=authority-count"; return 1; }
  [ "$path" = "$(get live.path NONE)" ] && [ "$path" = "$(get process.path NONE)" ] || { printf 'ERR\n'; event "REQUEST_ERR verb=$verb reason=wrong-path path=$path"; return 1; }
  ready_after="$(get ready.after 0)"
  if [ "$count" -le "$ready_after" ]; then event "REQUEST_ERR verb=$verb reason=not-ready count=$count"; return 1; fi
  case "$verb" in
    PING) printf 'OK\n' ;;
    BUILDID) printf 'BUILDID %s\n' "$(get process.build NONE)" ;;
    COMPANIONCAPS) printf 'COMPANIONCAPS 1 BACKUP RESTORE STATUS JOURNAL\n' ;;
    GUARDCAPS)
      if [ "${MOCK_STATEFUL_BAD_CAPS:-0}" = 1 ]; then printf 'OK GUARDCAPS 1 PREPARE DEFINE STREAM ACTION HEALTH REFUSAL STATUS EVIDENCE CANCEL RETIRE JOURNAL\n'
      else printf '%s\n' "$CAPS"; fi ;;
    GUARDSTATUS)
      if [ "${MOCK_STATEFUL_BAD_STATUS:-0}" = 1 ]; then printf 'OK GUARDSTATUS 1 PREPARED NONE NONE NONE NONE 0 0 0 NONE NONE 0 0\n'
      elif [ "$(get guard.phase EMPTY)" = EMPTY ] && [ "$(get guard.residue 0)" = 0 ]; then printf '%s\n' "$EMPTY_STATUS"
      else printf 'OK GUARDSTATUS 1 %s NONE NONE NONE NONE 0 0 0 NONE NONE 0 0\n' "$(get guard.phase UNKNOWN)"; fi ;;
    *) printf 'ERR\n'; event "REQUEST_ERR verb=$verb reason=unknown"; return 1 ;;
  esac
  event "REQUEST_OK verb=$verb"
}

boot_simulate() {
  authorities=0; asset=; path=
  for candidate in "$BOOT/system.rc" "$BOOT/vendor.rc" "$BOOT/service.sh"; do
    [ -f "$candidate" ] || continue
    case "$candidate" in
      *.rc)
        line="$(grep -E '^service hapaneld_helper /[^ ]+ --supervise$' "$candidate" 2>/dev/null || true)"
        [ "$(printf '%s\n' "$line" | awk 'NF { n++ } END { print n+0 }')" = 1 ] || { event "BOOT_REFUSED asset=${candidate##*/} reason=malformed"; return 1; }
        candidate_path="$(printf '%s\n' "$line" | awk '{print $3}')" ;;
      *)
        line="$(grep -E '^/[^ ]+ --supervise >/dev/null 2>&1 &$' "$candidate" 2>/dev/null || true)"
        [ "$(printf '%s\n' "$line" | awk 'NF { n++ } END { print n+0 }')" = 1 ] || { event "BOOT_REFUSED asset=${candidate##*/} reason=malformed"; return 1; }
        candidate_path="${line%% *}" ;;
    esac
    authorities=$((authorities + 1)); asset="$candidate"; path="$candidate_path"
  done
  [ "$authorities" = 1 ] || { event "BOOT_REFUSED authorities=$authorities"; return 1; }
  [ "$path" = "$(get live.path NONE)" ] || { event "BOOT_REFUSED path=$path reason=not-live"; return 1; }
  stop_processes
  launch "$path" supervised || return 1
  event "BOOT_OK asset=${asset##*/} path=$path"
}

inspect() {
  printf 'LIVE_PATH=%s\n' "$(get live.path NONE)"
  printf 'LIVE_BUILD=%s\n' "$(get live.build NONE)"
  printf 'LIVE_SHA256=%s\n' "$(get live.sha NONE)"
  printf 'LIVE_MODE=%s\n' "$(get live.mode NONE)"
  printf 'LIVE_OWNER=%s\n' "$(get live.owner NONE)"
  printf 'LIVE_NLINK=%s\n' "$(get live.nlink NONE)"
  live_path="$(get live.path NONE)"
  printf 'FILE_CANONICAL=%s\n' "$([ "$live_path" = /data/local/hapaneld-helper ] && echo PRESENT || echo ABSENT)"
  printf 'FILE_SYSTEM_LEGACY=%s\n' "$([ "$live_path" = /system/bin/hapaneld-helper ] && echo PRESENT || echo ABSENT)"
  printf 'FILE_DATA_LEGACY=%s\n' "$([ "$live_path" = /data/adb/hapaneld/hapaneld-helper ] && echo PRESENT || echo ABSENT)"
  printf 'SUPERVISORS=%s\n' "$(get process.supervisors 0)"
  printf 'WORKERS=%s\n' "$(get process.workers 0)"
  printf 'PROCESS_PATH=%s\n' "$(get process.path NONE)"
  printf 'PROCESS_BUILD=%s\n' "$(get process.build NONE)"
  printf 'GUARD_PHASE=%s\n' "$(get guard.phase EMPTY)"
  printf 'GUARD_RESIDUE=%s\n' "$(get guard.residue 0)"
  printf 'BOOT_KIND=%s\n' "$(get boot.kind none)"
  printf 'BOOT_SYSTEM=%s\n' "$([ -f "$BOOT/system.rc" ] && echo PRESENT || echo ABSENT)"
  printf 'BOOT_VENDOR=%s\n' "$([ -f "$BOOT/vendor.rc" ] && echo PRESENT || echo ABSENT)"
  printf 'BOOT_SERVICE=%s\n' "$([ -f "$BOOT/service.sh" ] && echo PRESENT || echo ABSENT)"
  printf 'TRANSACTION_OPEN=%s\n' "$(get transaction.open 0)"
  printf 'LAUNCH_ATTEMPTS=%s\n' "$(get launch.attempts 0)"
}

fingerprint() {
  # Deliberately excludes request/launch counters and the event log.  It is a mutation fingerprint,
  # not an observation fingerprint, so an armed refusal may be queried without changing its proof.
  inspect | sed '/^LAUNCH_ATTEMPTS=/d'
  for asset in system.rc vendor.rc service.sh; do
    if [ -f "$BOOT/$asset" ]; then sha256sum "$BOOT/$asset" | sed "s#  .*#  BOOT/$asset#"; fi
  done
}

write_noop_command() {
  command_path="$1" status="${2:-0}"
  printf '#!/bin/sh\nexit %s\n' "$status" > "$command_path"
  chmod 755 "$command_path"
}

copy_captured_remote() {
  slot="$1" root="$2"
  [ -f "$CAPTURED/$slot" ] && [ -f "$CAPTURED/$slot.remote" ] || return 1
  remote="$(sed -n '1p' "$CAPTURED/$slot.remote")"
  case "$remote" in /*) ;; *) return 1 ;; esac
  mkdir -p "$(dirname "$root$remote")"
  cp "$CAPTURED/$slot" "$root$remote"
}

emitted_rollback_cuts() {
  [ "$#" -eq 1 ] || die 'emitted-rollback-cuts KIND'
  cut_kind="$1"
  case "$cut_kind" in system|systemless|hybrid) ;; *) die "invalid cut kind: $cut_kind" ;; esac
  for required in helper rc hrc svc txn; do
    [ -f "$CAPTURED/$required" ] && [ -f "$CAPTURED/$required.remote" ] || die "missing captured $required asset"
  done

  cut_root="$MODEL/emitted-cuts-$cut_kind"
  work="$cut_root/work"
  gold="$cut_root/gold"
  base_bin="$cut_root/base-bin"
  fault_bin="$cut_root/fault-bin"
  counter="$cut_root/fault-count"
  rm -rf "$cut_root"
  mkdir -p "$work" "$base_bin" "$fault_bin"
  for command_name in mount stop pkill sync chcon start; do write_noop_command "$base_bin/$command_name" 0; done
  write_noop_command "$base_bin/pidof" 1

  # Execute the exact transaction bytes production pushed, changing only the device root prefix so
  # every absolute Android path lands in this disposable sandbox.
  sed -e "s#/data/#$work/data/#g" \
      -e "s#/system/#$work/system/#g" \
      -e "s#/vendor/#$work/vendor/#g" \
      -e "s#/dev/#$work/dev/#g" \
      "$CAPTURED/txn" > "$work/transaction"
  chmod 755 "$work/transaction"
  mkdir -p "$work/data/local/tmp" "$work/data/local" "$work/data/adb/hapaneld" \
    "$work/data/adb/service.d" "$work/system/bin" "$work/system/etc/init" \
    "$work/vendor/etc/init" "$work/dev"
  dd if=/dev/zero of="$work/dev/zero" bs=4096 count=1 >/dev/null 2>&1 ||
    die 'could not seed emitted transaction /dev/zero fixture'
  for captured_slot in helper rc hrc svc txn; do copy_captured_remote "$captured_slot" "$work"; done
  chmod 755 "$work$(sed -n '1p' "$CAPTURED/helper.remote")"

  transaction_id="$(sed -nE 's/^[[:space:]]*echo TRANSACTION_ID=([0-9a-f]{32})$/\1/p' "$CAPTURED/txn" | head -1)"
  target_apk="$(sed -nE 's/^[[:space:]]*echo TARGET_APK_SHA256=([0-9a-f]{64})$/\1/p' "$CAPTURED/txn" | head -1)"
  target_build="$(sed -nE 's/^[[:space:]]*echo TARGET_BUILD_ID=([0-9a-f]{64})$/\1/p' "$CAPTURED/txn" | head -1)"
  target_helper="$(sed -nE 's/^[[:space:]]*echo TARGET_HELPER_SHA256=([0-9a-f]{64})$/\1/p' "$CAPTURED/txn" | head -1)"
  printf '%s %s %s %s\n' "$transaction_id" "$target_apk" "$target_build" "$target_helper" |
    grep -Eq '^[0-9a-f]{32} [0-9a-f]{64} [0-9a-f]{64} [0-9a-f]{64}$' || die 'captured transaction identity is malformed'

  prior_helper="$cut_root/prior-helper"
  printf '#!/bin/sh\nexit 0\n' > "$prior_helper"
  chmod 755 "$prior_helper"
  case "$cut_kind" in
    system)
      cp "$prior_helper" "$work/system/bin/hapaneld-helper"
      printf 'service hapaneld_helper /system/bin/hapaneld-helper --supervise\n    class main\n    user root\n    group root\n' > "$work/system/etc/init/hapaneld-helper.rc"
      chmod 644 "$work/system/etc/init/hapaneld-helper.rc" ;;
    systemless)
      cp "$prior_helper" "$work/data/adb/hapaneld/hapaneld-helper"
      printf '#!/system/bin/sh\n/data/adb/hapaneld/hapaneld-helper --supervise >/dev/null 2>&1 &\n' > "$work/data/adb/service.d/hapaneld-helper.sh"
      chmod 755 "$work/data/adb/service.d/hapaneld-helper.sh" ;;
    hybrid)
      cp "$prior_helper" "$work/data/adb/hapaneld/hapaneld-helper"
      cp "$CAPTURED/hrc" "$work/vendor/etc/init/hapaneld-helper.rc"
      chmod 644 "$work/vendor/etc/init/hapaneld-helper.rc" ;;
  esac
  chmod 755 "$work/system/bin/hapaneld-helper" "$work/data/adb/hapaneld/hapaneld-helper" 2>/dev/null || true
  preinstall="$cut_root/preinstall"
  mkdir -p "$preinstall"
  cp -a "$work/." "$preinstall/"

  transaction_args="$transaction_id $target_apk $target_build $target_helper"
  install_output="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args 2>&1)" || {
    printf 'emitted %s install failed: %s\n' "$cut_kind" "$install_output" >&2
    return 1
  }
  [ "$install_output" = INSTALL_OK ] || { printf 'unexpected emitted install output: %s\n' "$install_output" >&2; return 1; }
  mkdir -p "$gold"
  cp -a "$work/." "$gold/"

  # The wrappers perform the real copy/removal first, then fail the exact authoritative operation
  # selected by FAULT_AFTER. That is a power/process cut immediately after durable mutation, not a
  # modelled state transition. Probe staging, journals, locks and recovery-file cleanup are excluded.
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    '/bin/cp "$@" || exit $?' \
    'authoritative=0' \
    'for value in "$@"; do' \
    '  case "$value" in' \
    '    "$FAULT_ROOT/data/local/hapaneld-helper"|"$FAULT_ROOT/system/bin/hapaneld-helper"|"$FAULT_ROOT/system/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/data/adb/hapaneld/hapaneld-helper"|"$FAULT_ROOT/data/adb/service.d/hapaneld-helper.sh"|"$FAULT_ROOT/vendor/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/system/bin/hapaneld-ledd"|"$FAULT_ROOT/system/etc/init/hapaneld-ledd.rc") authoritative=1 ;;' \
    '  esac' \
    'done' \
    '[ "$authoritative" = 1 ] || exit 0' \
    'count=$(( $(cat "$FAULT_COUNTER" 2>/dev/null || echo 0) + 1 ))' \
    'printf "%s\n" "$count" > "$FAULT_COUNTER"' \
    '[ "$count" != "$FAULT_AFTER" ] || exit 99' > "$fault_bin/cp"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    '/bin/rm "$@" || exit $?' \
    'authoritative=0' \
    'for value in "$@"; do' \
    '  case "$value" in' \
    '    "$FAULT_ROOT/data/local/hapaneld-helper"|"$FAULT_ROOT/system/bin/hapaneld-helper"|"$FAULT_ROOT/system/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/data/adb/hapaneld/hapaneld-helper"|"$FAULT_ROOT/data/adb/service.d/hapaneld-helper.sh"|"$FAULT_ROOT/vendor/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/system/bin/hapaneld-ledd"|"$FAULT_ROOT/system/etc/init/hapaneld-ledd.rc") authoritative=1 ;;' \
    '  esac' \
    'done' \
    '[ "$authoritative" = 1 ] || exit 0' \
    'count=$(( $(cat "$FAULT_COUNTER" 2>/dev/null || echo 0) + 1 ))' \
    'printf "%s\n" "$count" > "$FAULT_COUNTER"' \
    '[ "$count" != "$FAULT_AFTER" ] || exit 99' > "$fault_bin/rm"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    '/bin/mv "$@" || exit $?' \
    'authoritative=0' \
    'for value in "$@"; do' \
    '  case "$value" in' \
    '    "$FAULT_ROOT/data/local/hapaneld-helper"|"$FAULT_ROOT/system/bin/hapaneld-helper"|"$FAULT_ROOT/system/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/data/adb/hapaneld/hapaneld-helper"|"$FAULT_ROOT/data/adb/service.d/hapaneld-helper.sh"|"$FAULT_ROOT/vendor/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/system/bin/hapaneld-ledd"|"$FAULT_ROOT/system/etc/init/hapaneld-ledd.rc") authoritative=1 ;;' \
    '  esac' \
    'done' \
    '[ "$authoritative" = 1 ] || exit 0' \
    'count=$(( $(cat "$FAULT_COUNTER" 2>/dev/null || echo 0) + 1 ))' \
    'printf "%s\n" "$count" > "$FAULT_COUNTER"' \
    '[ "$count" != "$FAULT_AFTER" ] || exit 99' > "$fault_bin/mv"
  chmod 755 "$fault_bin/cp" "$fault_bin/rm" "$fault_bin/mv"

  rm -rf "$work"; mkdir -p "$work"; cp -a "$gold/." "$work/"
  printf '0\n' > "$counter"
  FAULT_ROOT="$work" FAULT_COUNTER="$counter" FAULT_AFTER=999 \
    PATH="$fault_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args >/dev/null 2>&1 || return 1
  operation_count="$(sed -n '1p' "$counter")"
  case "$operation_count" in ''|*[!0-9]*|0) return 1 ;; esac

  previous_rank=0
  cut=1
  while [ "$cut" -le "$operation_count" ]; do
    rm -rf "$work"; mkdir -p "$work"; cp -a "$gold/." "$work/"
    printf '0\n' > "$counter"
    if FAULT_ROOT="$work" FAULT_COUNTER="$counter" FAULT_AFTER="$cut" \
      PATH="$fault_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args >/dev/null 2>&1; then
      printf 'rollback cut %s unexpectedly completed\n' "$cut" >&2
      return 1
    fi
    cut_status="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "status-$cut_kind" $transaction_args 2>/dev/null | sed -n 's/^LIVE_STATE=//p')"
    case "$cut_status" in
      TARGET) rank=0 ;;
      BOOT_SWITCHED) rank=1 ;;
      CANONICAL_SWAPPED) rank=2 ;;
      PRE_SWAP) rank=3 ;;
      *) printf 'rollback cut %s classified %s\n' "$cut" "${cut_status:-EMPTY}" >&2; return 1 ;;
    esac
    [ "$rank" -ge "$previous_rank" ] || { printf 'rollback state regressed at cut %s\n' "$cut" >&2; return 1; }
    previous_rank="$rank"
    retry_output="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args 2>&1)" || return 1
    [ "$retry_output" = ROLLBACK_RESTARTED ] || { printf 'rollback retry at cut %s: %s\n' "$cut" "$retry_output" >&2; return 1; }
    final_status="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "status-$cut_kind" $transaction_args 2>/dev/null | sed -n 's/^LIVE_STATE=//p')"
    [ "$final_status" = PRE_SWAP ] || { printf 'rollback retry at cut %s ended %s\n' "$cut" "$final_status" >&2; return 1; }
    cut=$((cut + 1))
  done

  # Reproduce an external canonical replacement against the exact emitted install script.  The first
  # stop occurs only after all eight authoritative paths have been snapshotted and the v2 marker is
  # durable.  A canonical-only change with no native-replacement custody must retire this managed
  # transaction without mutating the external bytes, then retry from a fresh snapshot.  Every durable
  # cancel-intent, marker-retirement and cleanup boundary is process-cut below.
  seam_bin="$cut_root/seam-bin"
  seam_once="$cut_root/seam-once"
  seam_helper="$cut_root/external-helper"
  seam_helper_second="$cut_root/external-helper-second"
  seam_launch_log="$cut_root/external-launches"
  mkdir -p "$seam_bin"
  printf '#!/bin/sh\n[ -z "${SEAM_LAUNCH_LOG:-}" ] || printf "external helper invoked: %%s\\n" "$*" >> "$SEAM_LAUNCH_LOG"\nexit 0\nEXTERNAL_CANONICAL_ONE\n' > "$seam_helper"
  printf '#!/bin/sh\nexit 0\nEXTERNAL_CANONICAL_TWO\n' > "$seam_helper_second"
  chmod 700 "$seam_helper" "$seam_helper_second"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    'if [ ! -e "$SEAM_ONCE" ]; then' \
    '  : > "$SEAM_ONCE"' \
    '  cp "$SEAM_SOURCE" "$SEAM_ROOT/data/local/hapaneld-helper" || exit 1' \
    '  chmod 700 "$SEAM_ROOT/data/local/hapaneld-helper" || exit 1' \
    '  if [ "$SEAM_MODE" = ambiguous ]; then' \
    '    printf "ambiguous noncanonical churn\\n" > "$SEAM_ROOT/system/bin/hapaneld-ledd" || exit 1' \
    '    chmod 755 "$SEAM_ROOT/system/bin/hapaneld-ledd" || exit 1' \
    '  fi' \
    '  if [ "$SEAM_MODE" = custody ]; then' \
    '    printf "native replacement custody\\n" > "$SEAM_ROOT/data/local/.hapaneld-helper.new" || exit 1' \
    '  fi' \
    '  if [ "${SEAM_CUT_AFTER:-0}" = 1 ]; then kill -KILL "$PPID"; exit 137; fi' \
    'fi' \
    'exit 0' > "$seam_bin/stop"
  chmod 755 "$seam_bin/stop"

  case "$cut_kind" in
    system) cancel_marker="$work/system/bin/.hapaneld-helper-upgrade" ;;
    systemless) cancel_marker="$work/data/adb/hapaneld/.helper-upgrade.marker" ;;
    hybrid) cancel_marker="$work/data/adb/hapaneld/.helper-hybrid-upgrade.marker" ;;
  esac
  cancel_bin="$cut_root/cancel-bin"
  cancel_counter="$cut_root/cancel-count"
  cancel_active="$cut_root/cancel-active"
  mkdir -p "$cancel_bin"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    '/bin/mv "$@" || exit $?' \
    'destination="${!#}"' \
    'if [ "$destination" = "$CANCEL_MARKER" ] && grep -qx CANCEL_EXTERNAL=1 "$CANCEL_MARKER"; then' \
    '  : > "$CANCEL_ACTIVE"' \
    '  count=$(( $(cat "$CANCEL_COUNTER" 2>/dev/null || echo 0) + 1 ))' \
    '  printf "%s\\n" "$count" > "$CANCEL_COUNTER"' \
    '  if [ "$count" = "$FAULT_AFTER" ]; then kill -KILL "$PPID"; exit 137; fi' \
    'fi' \
    'exit 0' > "$cancel_bin/mv"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    '/bin/sync "$@" || exit $?' \
    '[ -e "$CANCEL_ACTIVE" ] || exit 0' \
    'count=$(( $(cat "$CANCEL_COUNTER" 2>/dev/null || echo 0) + 1 ))' \
    'printf "%s\\n" "$count" > "$CANCEL_COUNTER"' \
    'if [ "$count" = "$FAULT_AFTER" ]; then kill -KILL "$PPID"; exit 137; fi' \
    'exit 0' > "$cancel_bin/sync"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    'recursive=0' \
    'for option in "$@"; do case "$option" in -*r*) recursive=1 ;; esac; done' \
    'for value in "$@"; do' \
    '  case "$value" in -*) continue ;; esac' \
    '  existed=0; [ ! -e "$value" ] && [ ! -L "$value" ] || existed=1' \
    '  if [ "$recursive" = 1 ]; then /bin/rm -rf -- "$value"; else /bin/rm -f -- "$value"; fi || exit $?' \
    '  [ -e "$CANCEL_ACTIVE" ] && [ "$existed" = 1 ] || continue' \
    '  case "$value" in' \
    '    "$CANCEL_MARKER"|"$FAULT_ROOT/data/adb/hapaneld/.helper-recovery-$TRANSACTION_ID."*|"$FAULT_ROOT/data/local/.hapaneld-helper.provision-$TRANSACTION_ID"|"$FAULT_ROOT/system/etc/init/hapaneld-helper.rc.new"|"$FAULT_ROOT/data/adb/service.d/hapaneld-helper.sh.new"|"$FAULT_ROOT/vendor/etc/init/hapaneld-helper.rc.new") ;;' \
    '    *) continue ;;' \
    '  esac' \
    '  count=$(( $(cat "$CANCEL_COUNTER" 2>/dev/null || echo 0) + 1 ))' \
    '  printf "%s\\n" "$count" > "$CANCEL_COUNTER"' \
    '  if [ "$count" = "$FAULT_AFTER" ]; then kill -KILL "$PPID"; exit 137; fi' \
    'done' \
    'exit 0' > "$cancel_bin/rm"
  chmod 755 "$cancel_bin/mv" "$cancel_bin/sync" "$cancel_bin/rm"

  # First prove the pre-intent state is itself recoverable through the public cancel verb.
  rm -rf "$work"; mkdir -p "$work"; cp -a "$preinstall/." "$work/"; rm -f "$seam_once" "$seam_launch_log"
  SEAM_ROOT="$work" SEAM_SOURCE="$seam_helper" SEAM_ONCE="$seam_once" SEAM_MODE=exact SEAM_CUT_AFTER=1 SEAM_LAUNCH_LOG="$seam_launch_log" \
    PATH="$seam_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args >/dev/null 2>&1
  preintent_state="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "status-$cut_kind" $transaction_args 2>/dev/null | sed -n 's/^LIVE_STATE=//p')"
  [ "$preintent_state" = EXTERNAL_CANONICAL_CHANGE ] || { printf 'external pre-intent classified %s\n' "${preintent_state:-EMPTY}" >&2; return 1; }
  preintent_cancel="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "cancel-external-$cut_kind" $transaction_args 2>&1)"; preintent_cancel_status=$?
  [ "$preintent_cancel_status" -eq 5 ] && [ "$preintent_cancel" = EXTERNAL_CANONICAL_RETRY ] || {
    printf 'external pre-intent cancellation failed (%s): %s\n' "$preintent_cancel_status" "$preintent_cancel" >&2; return 1
  }
  [ ! -s "$seam_launch_log" ] || { printf 'external cancellation launched the changed canonical helper\n' >&2; return 1; }

  # Count the exact emitted cancellation boundaries on an uninterrupted run.
  rm -rf "$work"; mkdir -p "$work"; cp -a "$preinstall/." "$work/"
  rm -f "$seam_once" "$seam_launch_log" "$cancel_active"; printf '0\n' > "$cancel_counter"
  complete_cancel="$(CANCEL_MARKER="$cancel_marker" CANCEL_ACTIVE="$cancel_active" CANCEL_COUNTER="$cancel_counter" \
    FAULT_AFTER=999 FAULT_ROOT="$work" TRANSACTION_ID="$transaction_id" SEAM_ROOT="$work" \
    SEAM_SOURCE="$seam_helper" SEAM_ONCE="$seam_once" SEAM_MODE=exact SEAM_LAUNCH_LOG="$seam_launch_log" \
    PATH="$cancel_bin:$seam_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args 2>&1)"; complete_cancel_status=$?
  [ "$complete_cancel_status" -eq 5 ] && [ "$complete_cancel" = EXTERNAL_CANONICAL_RETRY ] || {
    printf 'external cancellation failed (%s): %s\n' "$complete_cancel_status" "$complete_cancel" >&2; return 1
  }
  cancel_operation_count="$(sed -n '1p' "$cancel_counter")"
  case "$cancel_operation_count" in ''|*[!0-9]*|0) printf 'external cancellation exposed no cut boundaries\n' >&2; return 1 ;; esac
  [ ! -s "$seam_launch_log" ] || { printf 'external cancellation launched the changed canonical helper\n' >&2; return 1; }
  fresh_output="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args 2>&1)" || return 1
  [ "$fresh_output" = INSTALL_OK ] || { printf 'fresh external snapshot retry: %s\n' "$fresh_output" >&2; return 1; }
  recovery_live="$work/data/adb/hapaneld/.helper-recovery-$transaction_id.live"
  cmp -s "$seam_helper" "$recovery_live" || { printf 'fresh retry did not snapshot external canonical bytes\n' >&2; return 1; }
  fresh_rollback="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args 2>&1)" || return 1
  [ "$fresh_rollback" = ROLLBACK_RESTARTED ] && cmp -s "$seam_helper" "$work/data/local/hapaneld-helper" || {
    printf 'fresh external snapshot rollback did not restore external bytes\n' >&2; return 1
  }

  cancel_cut=1
  while [ "$cancel_cut" -le "$cancel_operation_count" ]; do
    rm -rf "$work"; mkdir -p "$work"; cp -a "$preinstall/." "$work/"
    rm -f "$seam_once" "$seam_launch_log" "$cancel_active"; printf '0\n' > "$cancel_counter"
    CANCEL_MARKER="$cancel_marker" CANCEL_ACTIVE="$cancel_active" CANCEL_COUNTER="$cancel_counter" \
      FAULT_AFTER="$cancel_cut" FAULT_ROOT="$work" TRANSACTION_ID="$transaction_id" SEAM_ROOT="$work" \
      SEAM_SOURCE="$seam_helper" SEAM_ONCE="$seam_once" SEAM_MODE=exact SEAM_LAUNCH_LOG="$seam_launch_log" \
      PATH="$cancel_bin:$seam_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args >/dev/null 2>&1
    cut_live_state="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "status-$cut_kind" $transaction_args 2>/dev/null | sed -n 's/^LIVE_STATE=//p')"
    case "$cut_live_state" in
      CANCEL_EXTERNAL)
        cut_resume="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "cancel-external-$cut_kind" $transaction_args 2>&1)"; cut_resume_status=$?
        [ "$cut_resume_status" -eq 5 ] && [ "$cut_resume" = EXTERNAL_CANONICAL_RETRY ] || {
          printf 'cancel cut %s could not resume CANCEL_EXTERNAL (%s): %s\n' "$cancel_cut" "$cut_resume_status" "$cut_resume" >&2; return 1
        } ;;
      '') ;;
      *) printf 'cancel cut %s classified %s\n' "$cancel_cut" "$cut_live_state" >&2; return 1 ;;
    esac
    [ ! -s "$seam_launch_log" ] || { printf 'cancel cut %s launched external canonical\n' "$cancel_cut" >&2; return 1; }
    cut_fresh="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args 2>&1)" || return 1
    [ "$cut_fresh" = INSTALL_OK ] || { printf 'cancel cut %s fresh retry: %s\n' "$cancel_cut" "$cut_fresh" >&2; return 1; }
    cmp -s "$seam_helper" "$work/data/adb/hapaneld/.helper-recovery-$transaction_id.live" || {
      printf 'cancel cut %s fresh snapshot lost external bytes\n' "$cancel_cut" >&2; return 1
    }
    cut_rollback="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args 2>&1)" || return 1
    [ "$cut_rollback" = ROLLBACK_RESTARTED ] && cmp -s "$seam_helper" "$work/data/local/hapaneld-helper" || {
      printf 'cancel cut %s rollback restored stale bytes\n' "$cancel_cut" >&2; return 1
    }
    cancel_cut=$((cancel_cut + 1))
  done

  # Once cancel intent is durable, a second canonical change invalidates it and must retain the
  # marker for operator-visible HOLD rather than silently adopting a moving external target.
  rm -rf "$work"; mkdir -p "$work"; cp -a "$preinstall/." "$work/"
  rm -f "$seam_once" "$seam_launch_log" "$cancel_active"; printf '0\n' > "$cancel_counter"
  CANCEL_MARKER="$cancel_marker" CANCEL_ACTIVE="$cancel_active" CANCEL_COUNTER="$cancel_counter" \
    FAULT_AFTER=2 FAULT_ROOT="$work" TRANSACTION_ID="$transaction_id" SEAM_ROOT="$work" \
    SEAM_SOURCE="$seam_helper" SEAM_ONCE="$seam_once" SEAM_MODE=exact SEAM_LAUNCH_LOG="$seam_launch_log" \
    PATH="$cancel_bin:$seam_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args >/dev/null 2>&1
  cp "$seam_helper_second" "$work/data/local/hapaneld-helper"; chmod 700 "$work/data/local/hapaneld-helper"
  second_change="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "cancel-external-$cut_kind" $transaction_args 2>&1)"; second_change_status=$?
  [ "$second_change_status" -eq 4 ] && [ "$second_change" = TOPOLOGY_HOLD ] && [ -f "$cancel_marker" ] || {
    printf 'second external canonical change did not retain HOLD (%s): %s\n' "$second_change_status" "$second_change" >&2; return 1
  }

  rm -rf "$work"; mkdir -p "$work"; cp -a "$preinstall/." "$work/"; rm -f "$seam_once"
  ambiguous_output="$(SEAM_ROOT="$work" SEAM_SOURCE="$seam_helper" SEAM_ONCE="$seam_once" SEAM_MODE=ambiguous \
    PATH="$seam_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args 2>&1)"
  ambiguous_status=$?
  [ "$ambiguous_status" -eq 4 ] && [ "$ambiguous_output" = TOPOLOGY_HOLD ] || {
    printf 'ambiguous canonical seam did not hold (%s): %s\n' "$ambiguous_status" "$ambiguous_output" >&2
    return 1
  }
  candidate="$work/data/local/.hapaneld-helper.provision-$transaction_id"
  cmp -s "$seam_helper" "$work/data/local/hapaneld-helper" || { printf 'ambiguous seam renamed the candidate over canonical\n' >&2; return 1; }
  cmp -s "$CAPTURED/helper" "$candidate" || { printf 'ambiguous seam did not retain the staged candidate\n' >&2; return 1; }

  rm -rf "$work"; mkdir -p "$work"; cp -a "$preinstall/." "$work/"; rm -f "$seam_once"
  custody_output="$(SEAM_ROOT="$work" SEAM_SOURCE="$seam_helper" SEAM_ONCE="$seam_once" SEAM_MODE=custody \
    PATH="$seam_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "install-$cut_kind" $transaction_args 2>&1)"
  custody_status=$?
  [ "$custody_status" -eq 4 ] && [ "$custody_output" = TOPOLOGY_HOLD ] && [ -f "$cancel_marker" ] || {
    printf 'native replacement custody did not retain HOLD (%s): %s\n' "$custody_status" "$custody_output" >&2; return 1
  }
  cmp -s "$seam_helper" "$work/data/local/hapaneld-helper" || { printf 'custody HOLD renamed the candidate over canonical\n' >&2; return 1; }

  # Seed an authenticated legacy v1 TARGET journal, then cut the exact compatibility rollback after
  # intent publication and every authoritative restore/remove boundary.  A v1 journal predates the
  # canonical /data/local topology, so its selected helper and boot vector deliberately use the
  # historical paths while the freshly pushed transaction/script identity remains current.
  v1_base="$cut_root/v1-base"
  v1_prior_helper="$cut_root/v1-prior-helper"
  v1_prior_boot="$cut_root/v1-prior-boot"
  printf '#!/bin/sh\nexit 0\nV1_PRIOR_HELPER\n' > "$v1_prior_helper"
  printf 'prior v1 boot registration\n' > "$v1_prior_boot"
  chmod 755 "$v1_prior_helper"; chmod 644 "$v1_prior_boot"
  rm -rf "$work"; mkdir -p "$work"; cp -a "$preinstall/." "$work/"
  rm -f \
    "$work/data/local/hapaneld-helper" \
    "$work/system/bin/hapaneld-helper" "$work/system/etc/init/hapaneld-helper.rc" \
    "$work/data/adb/hapaneld/hapaneld-helper" "$work/data/adb/service.d/hapaneld-helper.sh" \
    "$work/vendor/etc/init/hapaneld-helper.rc" "$work/system/bin/hapaneld-ledd" \
    "$work/system/etc/init/hapaneld-ledd.rc" \
    "$work/system/bin/.hapaneld-helper-upgrade" "$work/data/adb/hapaneld/.helper-upgrade.marker" \
    "$work/data/adb/hapaneld/.helper-hybrid-upgrade.marker"
  v1_prior_helper_sha="$(sha256sum "$v1_prior_helper" | awk '{print $1}')"
  v1_prior_boot_sha="$(sha256sum "$v1_prior_boot" | awk '{print $1}')"
  case "$cut_kind" in
    system)
      v1_marker="$work/system/bin/.hapaneld-helper-upgrade"
      cp "$CAPTURED/helper" "$work/system/bin/hapaneld-helper"; chmod 755 "$work/system/bin/hapaneld-helper"
      printf 'service hapaneld_helper /system/bin/hapaneld-helper\n    class main\n    user root\n    group root\n    seclabel u:r:su:s0\n' > "$work/system/etc/init/hapaneld-helper.rc"
      chmod 644 "$work/system/etc/init/hapaneld-helper.rc"
      cp "$v1_prior_helper" "$work/system/bin/hapaneld-helper.hapaneld-recovery"
      cp "$v1_prior_boot" "$work/system/etc/init/hapaneld-helper.rc.hapaneld-recovery"
      chmod 755 "$work/system/bin/hapaneld-helper.hapaneld-recovery"
      chmod 644 "$work/system/etc/init/hapaneld-helper.rc.hapaneld-recovery" ;;
    systemless)
      v1_marker="$work/data/adb/hapaneld/.helper-upgrade.marker"
      cp "$CAPTURED/helper" "$work/data/adb/hapaneld/hapaneld-helper"; chmod 755 "$work/data/adb/hapaneld/hapaneld-helper"
      printf '#!/system/bin/sh\nwhile [ "$(getprop sys.boot_completed)" != "1" ]; do sleep 3; done\n/system/bin/stop hapaneld_helper 2>/dev/null\n/system/bin/stop hapaneld_ledd 2>/dev/null\n/system/bin/pkill -x hapaneld-helper 2>/dev/null\n/system/bin/pkill -x hapaneld-ledd 2>/dev/null\n/data/adb/hapaneld/hapaneld-helper >/dev/null 2>&1 &\n' > "$work/data/adb/service.d/hapaneld-helper.sh"
      chmod 755 "$work/data/adb/service.d/hapaneld-helper.sh"
      cp "$v1_prior_helper" "$work/data/adb/hapaneld/hapaneld-helper.hapaneld-recovery"
      cp "$v1_prior_boot" "$work/data/adb/service.d/hapaneld-helper.sh.hapaneld-recovery"
      chmod 755 "$work/data/adb/hapaneld/hapaneld-helper.hapaneld-recovery" "$work/data/adb/service.d/hapaneld-helper.sh.hapaneld-recovery" ;;
    hybrid)
      v1_marker="$work/data/adb/hapaneld/.helper-hybrid-upgrade.marker"
      cp "$CAPTURED/helper" "$work/data/adb/hapaneld/hapaneld-helper"; chmod 755 "$work/data/adb/hapaneld/hapaneld-helper"
      printf 'service hapaneld_helper /data/adb/hapaneld/hapaneld-helper\n    class main\n    user root\n    group root\n    seclabel u:r:su:s0\n' > "$work/vendor/etc/init/hapaneld-helper.rc"
      chmod 644 "$work/vendor/etc/init/hapaneld-helper.rc"
      cp "$v1_prior_helper" "$work/data/adb/hapaneld/hapaneld-helper.hapaneld-recovery"
      cp "$v1_prior_boot" "$work/data/adb/hapaneld/hapaneld-helper.vrc.hapaneld-recovery"
      chmod 755 "$work/data/adb/hapaneld/hapaneld-helper.hapaneld-recovery"
      chmod 644 "$work/data/adb/hapaneld/hapaneld-helper.vrc.hapaneld-recovery" ;;
  esac
  {
    printf 'JOURNAL_VERSION=1\nJOURNAL_SCOPE=APK_HELPER\n'
    printf 'TRANSACTION_ID=%s\nTARGET_APK_SHA256=%s\nTARGET_BUILD_ID=%s\nTARGET_HELPER_SHA256=%s\n' \
      "$transaction_id" "$target_apk" "$target_build" "$target_helper"
    case "$cut_kind" in
      system)
        printf 'OLD_BIN=1\nOLD_BIN_SHA256=%s\nOLD_SERVICE=1\nOLD_SERVICE_SHA256=%s\n' "$v1_prior_helper_sha" "$v1_prior_boot_sha"
        printf 'LEGACY_BIN=0\nLEGACY_BIN_SHA256=-\nLEGACY_SERVICE=0\nLEGACY_SERVICE_SHA256=-\nALT_BIN=0\nALT_BIN_SHA256=-\nALT_SERVICE=0\nALT_SERVICE_SHA256=-\n' ;;
      systemless)
        printf 'OLD_BIN=1\nOLD_BIN_SHA256=%s\nOLD_SERVICE=1\nOLD_SERVICE_SHA256=%s\n' "$v1_prior_helper_sha" "$v1_prior_boot_sha" ;;
      hybrid)
        printf 'OLD_BIN=1\nOLD_BIN_SHA256=%s\nOLD_RC=1\nOLD_RC_SHA256=%s\n' "$v1_prior_helper_sha" "$v1_prior_boot_sha"
        printf 'SYS_RC=0\nSYS_RC_SHA256=-\nSYS_BIN=0\nSYS_BIN_SHA256=-\nLEGACY_BIN=0\nLEGACY_BIN_SHA256=-\nLEGACY_SERVICE=0\nLEGACY_SERVICE_SHA256=-\nALT_SERVICE=0\nALT_SERVICE_SHA256=-\n' ;;
    esac
  } > "$v1_marker"
  chmod 600 "$v1_marker"
  mkdir -p "$v1_base"; cp -a "$work/." "$v1_base/"

  v1_fault_bin="$cut_root/v1-fault-bin"
  v1_counter="$cut_root/v1-count"
  v1_active="$cut_root/v1-active"
  mkdir -p "$v1_fault_bin"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    '/bin/mv "$@" || exit $?' \
    'destination="${!#}"' \
    'authoritative=0' \
    'if [ "$destination" = "$V1_MARKER" ] && grep -qx V1_ROLLBACK_IN_PROGRESS=1 "$V1_MARKER"; then : > "$V1_ACTIVE"; authoritative=1; fi' \
    'if [ -e "$V1_ACTIVE" ]; then' \
    '  case "$destination" in' \
    '    "$V1_MARKER"|"$FAULT_ROOT/system/bin/hapaneld-helper"|"$FAULT_ROOT/system/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/data/adb/hapaneld/hapaneld-helper"|"$FAULT_ROOT/data/adb/service.d/hapaneld-helper.sh"|"$FAULT_ROOT/vendor/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/system/bin/hapaneld-ledd"|"$FAULT_ROOT/system/etc/init/hapaneld-ledd.rc") authoritative=1 ;;' \
    '  esac' \
    'fi' \
    '[ "$authoritative" = 1 ] || exit 0' \
    'count=$(( $(cat "$V1_COUNTER" 2>/dev/null || echo 0) + 1 )); printf "%s\\n" "$count" > "$V1_COUNTER"' \
    'if [ "$count" = "$FAULT_AFTER" ]; then kill -KILL "$PPID"; exit 137; fi' \
    'exit 0' > "$v1_fault_bin/mv"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    '/bin/sync "$@" || exit $?' \
    '[ -e "$V1_ACTIVE" ] || exit 0' \
    'count=$(( $(cat "$V1_COUNTER" 2>/dev/null || echo 0) + 1 )); printf "%s\\n" "$count" > "$V1_COUNTER"' \
    'if [ "$count" = "$FAULT_AFTER" ]; then kill -KILL "$PPID"; exit 137; fi' \
    'exit 0' > "$v1_fault_bin/sync"
  printf '%s\n' '#!/usr/bin/env bash' \
    'set -u' \
    '/bin/rm "$@" || exit $?' \
    '[ -e "$V1_ACTIVE" ] || exit 0' \
    'authoritative=0' \
    'for value in "$@"; do' \
    '  case "$value" in' \
    '    "$FAULT_ROOT/system/bin/hapaneld-helper"|"$FAULT_ROOT/system/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/data/adb/hapaneld/hapaneld-helper"|"$FAULT_ROOT/data/adb/service.d/hapaneld-helper.sh"|"$FAULT_ROOT/vendor/etc/init/hapaneld-helper.rc"|"$FAULT_ROOT/system/bin/hapaneld-ledd"|"$FAULT_ROOT/system/etc/init/hapaneld-ledd.rc") authoritative=1 ;;' \
    '  esac' \
    'done' \
    '[ "$authoritative" = 1 ] || exit 0' \
    'count=$(( $(cat "$V1_COUNTER" 2>/dev/null || echo 0) + 1 )); printf "%s\\n" "$count" > "$V1_COUNTER"' \
    'if [ "$count" = "$FAULT_AFTER" ]; then kill -KILL "$PPID"; exit 137; fi' \
    'exit 0' > "$v1_fault_bin/rm"
  chmod 755 "$v1_fault_bin/mv" "$v1_fault_bin/sync" "$v1_fault_bin/rm"

  rm -rf "$work"; mkdir -p "$work"; cp -a "$v1_base/." "$work/"; rm -f "$v1_active"; printf '0\n' > "$v1_counter"
  V1_MARKER="$v1_marker" V1_ACTIVE="$v1_active" V1_COUNTER="$v1_counter" FAULT_AFTER=999 FAULT_ROOT="$work" \
    PATH="$v1_fault_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args >/dev/null 2>&1 || return 1
  v1_operation_count="$(sed -n '1p' "$v1_counter")"
  case "$v1_operation_count" in ''|*[!0-9]*|0) printf 'v1 rollback exposed no cut boundaries\n' >&2; return 1 ;; esac

  v1_previous_rank=0
  v1_cut=1
  while [ "$v1_cut" -le "$v1_operation_count" ]; do
    rm -rf "$work"; mkdir -p "$work"; cp -a "$v1_base/." "$work/"; rm -f "$v1_active"; printf '0\n' > "$v1_counter"
    V1_MARKER="$v1_marker" V1_ACTIVE="$v1_active" V1_COUNTER="$v1_counter" FAULT_AFTER="$v1_cut" FAULT_ROOT="$work" \
      PATH="$v1_fault_bin:$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args >/dev/null 2>&1
    v1_cut_state="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "status-$cut_kind" $transaction_args 2>/dev/null | sed -n 's/^LIVE_STATE=//p')"
    case "$v1_cut_state" in TARGET) v1_rank=0 ;; TRANSITION) v1_rank=1 ;; PRE_SWAP) v1_rank=2 ;;
      *) printf 'v1 rollback cut %s classified %s\n' "$v1_cut" "${v1_cut_state:-EMPTY}" >&2; return 1 ;; esac
    [ "$v1_rank" -ge "$v1_previous_rank" ] || { printf 'v1 rollback state regressed at cut %s\n' "$v1_cut" >&2; return 1; }
    v1_previous_rank="$v1_rank"
    v1_retry="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args 2>&1)" || return 1
    [ "$v1_retry" = ROLLBACK_RESTARTED ] || { printf 'v1 rollback retry at cut %s: %s\n' "$v1_cut" "$v1_retry" >&2; return 1; }
    v1_final_state="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "status-$cut_kind" $transaction_args 2>/dev/null | sed -n 's/^LIVE_STATE=//p')"
    [ "$v1_final_state" = PRE_SWAP ] || { printf 'v1 rollback retry at cut %s ended %s\n' "$v1_cut" "$v1_final_state" >&2; return 1; }
    v1_finalize="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "finalize-rollback-$cut_kind" $transaction_args 2>&1)" || return 1
    [ "$v1_finalize" = ROLLBACK_FINALIZED ] || { printf 'v1 rollback finalize at cut %s: %s\n' "$v1_cut" "$v1_finalize" >&2; return 1; }
    v1_cut=$((v1_cut + 1))
  done

  # POSIX `test ! -e` is true for a broken symlink.  Every v1 absence predicate must additionally
  # reject `-L`, otherwise a flag0 or target-absence check can misclassify an attacker-controlled
  # dangling link as PRE_SWAP/TARGET and let rollback remove it.  Exercise a distinct authoritative
  # absence predicate in each layout and prove refusal happens before even the rollback probe.
  rm -rf "$work"; mkdir -p "$work"; cp -a "$v1_base/." "$work/"
  case "$cut_kind" in
    system) nofollow_path="$work/system/bin/hapaneld-ledd" ;;
    systemless) nofollow_path="$work/vendor/etc/init/hapaneld-helper.rc" ;;
    hybrid) nofollow_path="$work/system/bin/hapaneld-helper" ;;
  esac
  ln -s /missing/hapaneld-nofollow-target "$nofollow_path"
  # Android already has /dev/null; the path-rewritten sandbox creates it lazily on the first
  # redirected transaction command, so seed that non-authoritative fixture node before comparing.
  : > "$work/dev/null"
  nofollow_before="$cut_root/v1-nofollow-before"
  mkdir -p "$nofollow_before"; cp -a "$work/." "$nofollow_before/"
  nofollow_state="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "status-$cut_kind" $transaction_args 2>/dev/null | sed -n 's/^LIVE_STATE=//p')"
  [ "$nofollow_state" = UNKNOWN ] || { printf 'v1 broken symlink classified %s\n' "${nofollow_state:-EMPTY}" >&2; return 1; }
  nofollow_output="$(PATH="$base_bin:/usr/bin:/bin" /bin/sh "$work/transaction" "rollback-$cut_kind" $transaction_args 2>&1)"; nofollow_status=$?
  [ "$nofollow_status" -eq 1 ] && [ -z "$nofollow_output" ] || {
    printf 'v1 broken symlink rollback did not refuse exactly (%s): %s\n' "$nofollow_status" "$nofollow_output" >&2; return 1
  }
  [ "$(readlink "$nofollow_path")" = /missing/hapaneld-nofollow-target ] || { printf 'v1 broken symlink target changed\n' >&2; return 1; }
  diff -r --no-dereference "$nofollow_before" "$work" >/dev/null 2>&1 || { printf 'v1 broken symlink refusal mutated authoritative state\n' >&2; return 1; }
  printf 'EMITTED_ROLLBACK_CUTS_OK kind=%s operations=%s\n' "$cut_kind" "$operation_count"
  printf 'EMITTED_EXTERNAL_CANCEL_OK kind=%s operations=%s\n' "$cut_kind" "$cancel_operation_count"
  printf 'EMITTED_V1_ROLLBACK_CUTS_OK kind=%s operations=%s\n' "$cut_kind" "$v1_operation_count"
  printf 'EMITTED_V1_NOFOLLOW_HOLD_OK kind=%s\n' "$cut_kind"
}

selftest() {
  a=$(printf '%064d' 1); b=$(printf '%064d' 2)
  seed system /system/bin/hapaneld-helper "$a" EMPTY 1
  [ "$(request /system/bin/hapaneld-helper PING)" = OK ] || return 1
  set +e; unknown="$(request /system/bin/hapaneld-helper INVENTED)"; status=$?; set -e
  [ "$unknown" = ERR ] && [ "$status" -ne 0 ] || return 1
  stop_processes
  set +e; stopped="$(request /system/bin/hapaneld-helper PING)"; status=$?; set -e
  [ "$stopped" = ERR ] && [ "$status" -ne 0 ] || return 1
  launch /system/bin/hapaneld-helper supervised
  set +e; launch /system/bin/hapaneld-helper supervised; status=$?; set -e
  [ "$status" -ne 0 ] || return 1
  seed hybrid /data/adb/hapaneld/hapaneld-helper "$b" EMPTY 1
  cp "$BOOT/vendor.rc" "$BOOT/system.rc"
  set +e; boot_simulate; status=$?; set -e
  [ "$status" -ne 0 ] || return 1
  printf 'helper-state self-test: ok\n'
}

ensure_model
command="${1:-}"; [ "$#" -gt 0 ] && shift || true
case "$command" in
  reset) clear_model ;;
  seed) seed "$@" ;;
  capture) capture "$@" ;;
  install) install "$@" ;;
  record) transaction_record "$@" ;;
  rollback) rollback ;;
  commit) commit ;;
  replacement-safe) replacement_safe ;;
  launch) launch "$@" ;;
  stop) stop_processes ;;
  request) request "$@" ;;
  boot) boot_simulate ;;
  inspect) inspect ;;
  fingerprint) fingerprint ;;
  emitted-rollback-cuts) emitted_rollback_cuts "$@" ;;
  event) event "$@" ;;
  selftest) selftest ;;
  *) die 'expected reset, seed, capture, install, record, rollback, commit, replacement-safe, launch, stop, request, boot, inspect, fingerprint, emitted-rollback-cuts, event, or selftest' ;;
esac
