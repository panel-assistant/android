  "native": {
    "status": {
      "type": "StatusPalette",
      "format": "hex",
      "themed": true,
      "doc": "The panel's own background behind a full-screen Notice and the proximity wizard, and the admin launcher's text and button. Hex strings, because the dashboard's blank document puts the background into HTML.",
      "fields": {
        "background": {
          "dark": "#111111",
          "light": "#ffffff"
        },
        "body": {
          "dark": "#c8ccd2",
          "light": "#2a2e34"
        },
        "subtle": {
          "dark": "#8a8f99",
          "light": "#5a6068"
        },
        "accent": {
          "dark": "#4a9eff",
          "light": "#1669d6"
        },
        "actionBackground": {
          "dark": "#2f6fd0",
          "light": "#2557a7",
          "doc": "The emphasised action. Dark: 3.87:1 against the page and 4.88:1 for its label; the earlier #2557a7 reached only 2.70:1 against the dark page."
        }
      }
    },
    "launcher": {
      "type": "LauncherColours",
      "format": "hex",
      "themed": true,
      "doc": "The admin launcher's tile grid. Its tiles are drawn in the status background, so the page behind them is a shade off it or the tiles vanish.",
      "fields": {
        "page": {
          "dark": "#111111",
          "light": "#f3f4f6"
        },
        "tile": {
          "dark": "#1d1f24",
          "light": "#ffffff"
        }
      }
    },
    "notice": {
      "type": "NoticeColours",
      "format": "int",
      "themed": true,
      "doc": "The Home Assistant restart notice (HaLifecycleBar). DARK is the dark card, shown over a light dashboard, and LIGHT the light card over a dark one. Every text role keeps WCAG AA 4.5:1 or better over a white, grey or black dashboard at the card's opacity (worst 5.4:1, secondary labels on the dark card); the accent marks only the dot and the track, which need 3:1 and get 5.1:1 or better. Recheck those figures before changing a colour.",
      "fields": {
        "surface": {
          "dark": "#16181C",
          "light": "#F7F8FA"
        },
        "text": {
          "dark": "#F3F5F7",
          "light": "#15181C"
        },
        "secondary": {
          "dark": "#C3CAD1",
          "light": "#3D4650"
        },
        "muted": {
          "dark": "#A9B2BC",
          "light": "#46505B"
        },
        "accent": {
          "dark": "#4FC3F7",
          "light": "#01579B"
        }
      }
    },
    "chip": {
      "type": "ChipColours",
      "format": "int",
      "themed": true,
      "doc": "The migration notice's amber, opaque because the surface behind is an arbitrary dashboard. The chips themselves are compact Notices.",
      "fields": {
        "warningSurface": {
          "dark": "#2A2418",
          "light": "#FDF6E7"
        },
        "warningBorder": {
          "dark": "#D2951F",
          "light": "#A5741A"
        },
        "warningLabel": {
          "dark": "#FAF2E2",
          "light": "#3A2A08"
        }
      }
    },
    "proximity": {
      "format": "int",
      "themed": false,
      "doc": "The proximity wizard's pictogram, countdown ring and wave cue. The wizard's text, buttons and background are the shared Notice and status colours.",
      "fields": {
        "wave": "#C8ADFF",
        "waveText": "#E3D5FF",
        "pictogramFloor": "#405671",
        "pictogramPanel": "#172B43",
        "pictogramPanelLine": "#487CB8",
        "pictogramHand": "#C5DEFE",
        "ringAccent": "#71ADFF",
        "ringTrack": "#273B54"
      }
    },
    "overlay": {
      "format": "int",
      "themed": false,
      "doc": "Views drawn over the dashboard that are not cards: the voice attention glow and ripple, the camera indicator, the navigation bar and the dashboard's own dark backdrop.",
      "fields": {
        "voiceAttention": {
          "value": "#00FF88",
          "doc": "The voice glow and wake ripple, unless Home Assistant names another."
        },
        "cameraRecording": "#DC1E1E",
        "navbarBar": {
          "value": "#282C34C2",
          "doc": "Charcoal at about 76%: translucent but still reads solid."
        },
        "navbarPress": {
          "value": "#FFFFFF55",
          "doc": "Press-feedback flash, about 33% white."
        },
        "navbarSeparator": {
          "value": "#FFFFFF99",
          "doc": "60% white group divider."
        },
        "navbarSliderTrack": {
          "value": "#FFFFFF55",
          "doc": "The slider's unfilled track, about 33% white."
        },
        "dashboardDark": "#121212"
      }
    },
    "page": {
      "format": "hex",
      "themed": false,
      "doc": "Colours Kotlin writes as text rather than through a stylesheet: the bare `:8888` result pages that load no CSS, and the capability colours in the status JSON Panel Assistant reads.",
      "fields": {
        "background": "#111",
        "text": "#eee",
        "link": "#9cf",
        "capabilityOk": "#48c774",
        "capabilityDegraded": "#d9a528",
        "capabilityNone": "#d04a3b",
        "capabilityUnknown": "#888"
      }
    }
  }
}
