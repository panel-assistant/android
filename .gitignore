/.docs-assets/

# UI layout-test deps (playwright-core)
tools/test/node_modules/

# Vendor firmware images for private hardware research — NEVER commit (large binaries; public repo).
# No trailing slash so it also ignores the symlink form (the blobs live in /media to stay out of HA
# backups; this path is symlinked there).
vendor-firmwares

_site/
